---
const { title, text, url, locale = 'zh-CN' } = Astro.props as { title: string; text: string; url: string; locale?: 'zh-CN' | 'zh-TW' };
const labels = locale === 'zh-TW' ? { share: '分享文章', opened: '已開啟分享', copied: '連結已複製', failed: '分享失敗，請複製網址' } : { share: '分享文章', opened: '已打开分享', copied: '链接已复制', failed: '分享失败，请复制网址' };
---
<div class="share" data-opened-label={labels.opened} data-copied-label={labels.copied} data-failed-label={labels.failed}>
	<button type="button" data-share data-title={title} data-text={text} data-url={url}>{labels.share}</button>
	<span role="status" aria-live="polite" data-share-status></span>
</div>

<script>
	import { onPageLoad } from '../lib/client-lifecycle';
	import { copyText } from '../lib/clipboard';

	onPageLoad('share-button', (signal) => {
		document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
			let timer = 0;
			signal.addEventListener('abort', () => window.clearTimeout(timer), { once: true });
			button.addEventListener('click', async () => {
				const root = button.closest<HTMLElement>('.share');
				const openedLabel = root?.dataset.openedLabel || '已打开分享';
				const copiedLabel = root?.dataset.copiedLabel || '链接已复制';
				const payload = { title: button.dataset.title || document.title, text: button.dataset.text || '', url: button.dataset.url || location.href };
				const status = root?.querySelector<HTMLElement>('[data-share-status]');
				window.clearTimeout(timer);
				button.disabled = true;
				if (status) status.textContent = '';
				let message = '';
				try {
					if (typeof navigator.share === 'function') {
						try { await navigator.share(payload); message = openedLabel; }
						catch (error) {
							if (error instanceof DOMException && error.name === 'AbortError') return;
							if (signal.aborted) return;
						}
					}
					if (!message) message = await copyText(payload.url) ? copiedLabel : root?.dataset.failedLabel || '分享失败，请复制网址';
					if (signal.aborted) return;
					if (status) status.textContent = message;
					timer = window.setTimeout(() => { if (status?.isConnected) status.textContent = ''; }, 3000);
				} finally {
					button.disabled = false;
				}
			}, { signal });
		});
	});
</script>

<style>
	.share { display: flex; align-items: center; gap: 12px; }
	button { padding: 0 0 7px; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; color: var(--muted); font: 0.75rem/1.5 var(--mono); letter-spacing: .04em; cursor: pointer; transition: color 180ms ease, border-color 180ms ease; }
	button:hover { color: var(--accent); border-color: var(--accent); }
	span { color: var(--muted); font: 0.75rem var(--mono); }
</style>
