---
const { slug, locale = 'zh-CN' } = Astro.props as { slug: string; locale?: 'zh-CN' | 'zh-TW' };
const label = locale === 'zh-TW' ? '閱讀量' : '阅读量';
---
<span class="views" data-view-counter data-slug={slug} data-label={label}>{label} --</span>

<script>
	import { onPageLoad } from '../lib/client-lifecycle';

	onPageLoad('view-counter', (signal) => {
		document.querySelectorAll<HTMLElement>('[data-view-counter]').forEach((item) => {
			const slug = item.dataset.slug || '';
			const label = item.dataset.label || '阅读量';
			const visible = document.visibilityState === 'visible';
			const prefetched = /bot|crawler|spider/i.test(navigator.userAgent);
			const seenKey = `viewed:${slug}`;
			const shouldIncrement = visible && !prefetched && sessionStorage.getItem(seenKey) !== '1';
			fetch(`/api/views/${encodeURIComponent(slug)}${shouldIncrement ? '?increment=1' : ''}`, { signal })
				.then((response) => response.ok ? response.json() : null)
				.then((data) => {
					if (!data || typeof data.views !== 'number' || signal.aborted) return;
					item.textContent = `${label} ${data.views}`;
					if (shouldIncrement) sessionStorage.setItem(seenKey, '1');
				})
				.catch(() => {});
		});
	});
</script>

<style>
	.views { color: var(--muted); font: 11px var(--mono); }
</style>
