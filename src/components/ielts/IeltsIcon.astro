---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
	{paths[name].map((d) => <path d={d} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />)}
</svg>
