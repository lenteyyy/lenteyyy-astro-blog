	info: ['M12 17v-6M12 8h.01', 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'],
	headphones: ['M4 14v-2a8 8 0 0 1 16 0v2', 'M4 14h4v6H6a2 2 0 0 1-2-2Zm16 0h-4v6h2a2 2 0 0 0 2-2Z'],
	book: ['M4 5.5c3-.8 5.7-.2 8 1.5v13c-2.3-1.7-5-2.3-8-1.5Z', 'M20 5.5c-3-.8-5.7-.2-8 1.5v13c2.3-1.7 5-2.3 8-1.5Z'],
	pen: ['m4 20 4.2-1 10.9-10.9-3.2-3.2L5 15.8Z', 'm13.8 7 3.2 3.2M4 20l1-4.2 3.2 3.2Z'],
	chat: ['M20 11a8 8 0 0 1-9 7.9L5 21l.9-4A8 8 0 1 1 20 11Z', 'M8.5 11h.01M12 11h.01M15.5 11h.01'],
	file: ['M7 3h7l4 4v14H7Z', 'M14 3v5h4M10 13h5M10 17h5'],
