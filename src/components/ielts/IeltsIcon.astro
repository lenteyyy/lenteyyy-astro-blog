---
type IconName =
	| 'home'
	| 'calendar'
	| 'folder'
	| 'clipboard'
	| 'info'
	| 'headphones'
	| 'book'
	| 'pen'
	| 'chat'
	| 'file'
	| 'play'
	| 'user'
	| 'arrow'
	| 'sun'
	| 'moon';

interface Props {
