---
import IeltsLayout from '../../layouts/IeltsLayout.astro';
import {dictationBooks,dictationWords} from '../../lib/ielts/dictation-library';
const {accountId,kind,demo=false}=Astro.props as {accountId:string;kind:'mistakes'|'words';demo?:boolean};
const title=kind==='mistakes'?'模考错题本':'单词本';
const payload=JSON.stringify({accountId,kind,demo,...(kind==='words'?{books:dictationBooks,words:dictationWords}:{} )}).replace(/</g,'\\u003c');
---
<IeltsLayout title={`${title} · Lenteyyy IELTS`} description={title} telemetry={false}>
 <main class="notebook" data-notebook>
  <a class="back" href={kind==='mistakes'?'/ielts#mock':'/ielts#notes'}>← 返回学习中心</a>
  <header><h1>{title}</h1><button type="button" data-export>导出</button></header>
  <p class="muted">仅保存在当前浏览器，按账户区分；不跨设备同步。</p>
  <div class="filters"><label class="search-label">搜索<input type="search" data-search maxlength="100" placeholder={kind==='mistakes'?'试卷、错因或笔记':'单词、释义或分组'} /></label><label>状态<select data-state><option value="all">全部</option><option value="due">到期复习</option><option value="learning">未掌握</option><option value="mastered">已掌握</option></select></label><label>{kind==='mistakes'?'错因':'分组'}<select data-group><option value="all">全部</option></select></label><button class="primary" type="button" data-review-due>复习到期内容</button></div>
  {kind==='words'&&<details class="add"><summary>添加单词</summary><form data-word-form><label>单词或短语<input name="word" maxlength="80" required lang="en" /></label><label>释义<input name="meaning" maxlength="200" /></label><label>分组<input name="group" maxlength="40" placeholder="我的单词" /></label><label class="wide">例句<textarea name="example" maxlength="400" rows="2"></textarea></label><button class="primary" type="submit">保存单词</button></form><div class="catalog"><label>从词书收藏<select data-catalog-book>{dictationBooks.map(b=><option value={b.id}>{b.title}</option>)}</select></label><input data-catalog-search type="search" aria-label="搜索词书单词" placeholder="搜索已有录音的单词" maxlength="80" /><div data-catalog-list></div></div></details>}
  <p data-status role="status" aria-live="polite"></p><p class="muted" data-count></p><div class="entries" data-list></div>
  <noscript>请启用JavaScript读取本机存档。</noscript>
 </main>
 <dialog data-review-dialog aria-labelledby="review-title"><div class="dialog-head"><h2 id="review-title" data-review-title>复习</h2><button type="button" data-close-review aria-label="关闭复习">×</button></div><p data-review-progress class="muted"></p><div data-context></div><form data-review-form><div data-review-inputs></div><button class="primary" type="submit">检查</button></form><p data-feedback role="status"></p><div data-word-rating hidden><button type="button" data-rating="wrong">需要复习</button><button class="primary" type="button" data-rating="correct">记住了</button></div><button type="button" data-review-next hidden>下一项</button></dialog>
 <script type="application/json" is:inline id="notebook-payload" set:html={payload} />
</IeltsLayout>
<script>import '../../lib/ielts/notebook-client';</script>
<style is:global>
 [data-context] .scan-text-layer{display:none}
 .notebook{width:100%;max-width:1100px;margin:0 auto;padding:48px 28px 64px;font-size:18px;line-height:1.8}.notebook .back{font-size:16px;color:var(--ielts-muted)}.notebook header,.dialog-head{display:flex;justify-content:space-between;align-items:center;gap:16px}.notebook h1{font-size:clamp(30px,3vw,44px);letter-spacing:-.035em;color:var(--ielts-ink);margin:28px 0 20px}.notebook .muted,[data-review-dialog] .muted{color:var(--ielts-muted);font-size:16px}.notebook button,.notebook select,.notebook input,.notebook textarea,[data-review-dialog] button,[data-review-dialog] input{font:inherit;color:var(--ielts-ink);background:var(--ielts-card);border:1px solid var(--ielts-line);border-radius:6px;padding:10px 14px}.notebook button,[data-review-dialog] button{cursor:pointer}.notebook .primary,[data-review-dialog] .primary{background:var(--ielts-ink);color:var(--ielts-bg);border-color:var(--ielts-ink)}.notebook label{display:flex;flex-direction:column;gap:6px}.notebook .filters{display:flex;flex-wrap:wrap;gap:16px;align-items:end;margin:28px 0}.notebook .search-label{flex:1;min-width:180px}.notebook .add{border-block:1px solid var(--ielts-line);padding:18px 0}.notebook summary{cursor:pointer;color:var(--ielts-ink)}.notebook [data-word-form]{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:22px 0}.notebook .wide{grid-column:1/-1}.notebook .catalog{border-top:1px solid var(--ielts-line);padding-top:22px;display:grid;gap:14px}.notebook [data-catalog-list]{display:flex;gap:10px;flex-wrap:wrap}.notebook .entry{border-top:1px solid var(--ielts-line);padding:24px 0;overflow-wrap:anywhere}.notebook .entry h2{font-size:22px;color:var(--ielts-ink);margin:0 0 10px}.notebook .entry p{margin:6px 0;white-space:pre-wrap}.notebook .entry-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.notebook .entry textarea{width:100%;max-width:100%;margin-top:10px;resize:vertical}.notebook .entry select{max-width:100%}.notebook button:disabled,[data-review-dialog] button:disabled{opacity:.5;cursor:default}[data-review-dialog]{max-width:900px;width:calc(100% - 32px);max-height:90dvh;overflow:auto;color:var(--ielts-text);background:var(--ielts-card);border:1px solid var(--ielts-line);border-radius:6px;padding:24px;font-size:18px;line-height:1.8}[data-review-dialog]::backdrop{background:#0008}[data-review-dialog] h2{margin:0;font-size:24px;color:var(--ielts-ink)}[data-context]{white-space:pre-wrap;overflow-wrap:anywhere}[data-context] img{display:block;width:100%;margin:16px 0}[data-context] audio{width:100%;margin:16px 0}[data-review-inputs] label{display:flex;flex-direction:column;margin:16px 0;gap:8px}[data-review-inputs] input{width:100%}[data-word-rating]{display:flex;gap:12px}[data-review-next]{margin-top:14px}@media(max-width:600px){.notebook{padding:28px 20px 40px}.notebook .filters>*{flex:1;min-width:140px}.notebook [data-word-form]{grid-template-columns:1fr}.notebook header{align-items:center}.notebook .entry-actions button{flex:1}[data-review-dialog]{padding:18px}}
</style>
