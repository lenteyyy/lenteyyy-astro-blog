<script>
	import { onPageLoad } from '../lib/client-lifecycle';

	onPageLoad('reading-progress', (signal) => {
		const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
		const article = document.querySelector<HTMLElement>('.article-body');
		if (!progress || !article) return;
		const headings = Array.from(article.querySelectorAll<HTMLElement>('h2[id], h3[id]'));
		const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
		let activeId = '';
		let ticking = false;
		let frame = 0;

		tocLinks.forEach((link) => link.addEventListener('click', (event) => {
			const id = link.dataset.tocLink;
			const target = id ? document.getElementById(id) : null;
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
			history.replaceState(null, '', `#${id}`);
		}, { signal }));

		const updateReading = () => {
			ticking = false;
			if (signal.aborted) return;
			const rect = article.getBoundingClientRect();
			const total = rect.height - window.innerHeight * 0.65;
			const read = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
			progress.style.transform = `scaleX(${read / Math.max(total, 1)})`;
			let nextId = activeId;
			for (const heading of headings) if (heading.getBoundingClientRect().top <= 130) nextId = heading.id;
			if (nextId && nextId !== activeId) {
				activeId = nextId;
				tocLinks.forEach((link) => link.classList.toggle('active', link.dataset.tocLink === activeId));
				history.replaceState(null, '', `#${activeId}`);
			}
		};
		const requestUpdate = () => {
			if (ticking) return;
			ticking = true;
			frame = requestAnimationFrame(updateReading);
		};
		updateReading();
		window.addEventListener('scroll', requestUpdate, { passive: true, signal });
		window.addEventListener('resize', requestUpdate, { signal });
		signal.addEventListener('abort', () => cancelAnimationFrame(frame), { once: true });
	});
</script>
