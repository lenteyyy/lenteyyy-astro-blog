---
import type { SiteLocale } from '../lib/locale';
import { renderMarkdown } from '../lib/markdown';

const { source, locale = 'zh-CN' } = Astro.props as { source: string; locale?: SiteLocale };
const copyDoneLabel = locale === 'zh-TW' ? '已複製' : '已复制';
const copyLabel = locale === 'zh-TW' ? '複製' : '复制';
const html = renderMarkdown(source, locale);
---
<div class="article-content" data-copy-done={copyDoneLabel} data-copy-label={copyLabel} data-close-label={locale === 'zh-TW' ? '關閉' : '关闭'} data-previous-label={locale === 'zh-TW' ? '上一張' : '上一张'} data-next-label={locale === 'zh-TW' ? '下一張' : '下一张'} set:html={html} />

<script>
	import { onPageLoad } from '../lib/client-lifecycle';

	onPageLoad('obsidian-content', (signal) => {
		const content = document.querySelector<HTMLElement>('.article-content');
		if (!content) return;
		const images = Array.from(content.querySelectorAll<HTMLImageElement>('[data-lightbox-image]'));
		const copyDoneLabel = content.dataset.copyDone || '已复制';
		const copyLabel = content.dataset.copyLabel || '复制';
		let currentIndex = 0;
		let touchStartX = 0;
		let lightbox: HTMLElement | null = null;

		const closeLightbox = () => {
			lightbox?.classList.remove('is-open');
			if (lightbox) {
				lightbox.hidden = true;
				lightbox.setAttribute('aria-hidden', 'true');
			}
			document.documentElement.classList.remove('has-lightbox');
			if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
		};
		const showImage = (index: number) => {
			if (!images.length) return;
			currentIndex = (index + images.length) % images.length;
			const image = images[currentIndex];
			const box = ensureLightbox();
			const boxImage = box.querySelector<HTMLImageElement>('img');
			const boxCaption = box.querySelector<HTMLElement>('figcaption');
			if (!boxImage || !boxCaption) return;
			boxImage.src = image.currentSrc || image.src;
			boxImage.alt = image.alt || '';
			boxCaption.textContent = image.dataset.caption || '';
			boxCaption.hidden = !image.dataset.caption;
			box.hidden = false;
			box.setAttribute('aria-hidden', 'false');
			box.classList.add('is-open');
			document.documentElement.classList.add('has-lightbox');
		};
		const ensureLightbox = () => {
			if (lightbox) return lightbox;
			lightbox = document.createElement('div');
			lightbox.className = 'lightbox';
			lightbox.hidden = true;
			lightbox.setAttribute('aria-hidden', 'true');
			const close = document.createElement('button');
			const previous = document.createElement('button');
			const next = document.createElement('button');
			const figure = document.createElement('figure');
			const boxImage = document.createElement('img');
			const boxCaption = document.createElement('figcaption');
			close.className = 'lightbox-close'; close.type = 'button'; close.ariaLabel = content.dataset.closeLabel || '关闭'; close.textContent = '×';
			previous.className = 'lightbox-prev'; previous.type = 'button'; previous.ariaLabel = content.dataset.previousLabel || '上一张'; previous.textContent = '‹';
			next.className = 'lightbox-next'; next.type = 'button'; next.ariaLabel = content.dataset.nextLabel || '下一张'; next.textContent = '›';
			figure.append(boxImage, boxCaption); lightbox.append(close, previous, figure, next); document.body.append(lightbox);
			lightbox.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;
				if (target === lightbox || target.closest('.lightbox-close')) closeLightbox();
				if (target.closest('.lightbox-prev')) showImage(currentIndex - 1);
				if (target.closest('.lightbox-next')) showImage(currentIndex + 1);
			}, { signal });
			lightbox.addEventListener('touchstart', (event) => { touchStartX = event.touches[0]?.clientX || 0; }, { passive: true, signal });
			lightbox.addEventListener('touchend', (event) => {
				const diff = (event.changedTouches[0]?.clientX || 0) - touchStartX;
				if (Math.abs(diff) > 45) showImage(currentIndex + (diff < 0 ? 1 : -1));
			}, { signal });
			return lightbox;
		};

		images.forEach((image, index) => image.addEventListener('click', () => showImage(index), { signal }));
		document.addEventListener('click', async (event) => {
			const target = event.target as HTMLElement;
			if (!content.contains(target)) return;
			const button = target.closest<HTMLButtonElement>('.copy-code');
			const anchor = target.closest<HTMLButtonElement>('.heading-anchor');
			if (button) {
				const code = button.nextElementSibling?.textContent || '';
				await navigator.clipboard?.writeText(code);
				button.textContent = copyDoneLabel;
				window.setTimeout(() => { if (button.isConnected) button.textContent = copyLabel; }, 1400);
			}
			if (anchor?.dataset.anchor) {
				const url = `${location.origin}${location.pathname}#${anchor.dataset.anchor}`;
				history.replaceState(null, '', `#${anchor.dataset.anchor}`);
				await navigator.clipboard?.writeText(url);
			}
		}, { signal });
		document.addEventListener('keydown', (event) => {
			if (!lightbox?.classList.contains('is-open')) return;
			if (event.key === 'Escape') { event.preventDefault(); event.stopImmediatePropagation(); closeLightbox(); }
			if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
			if (event.key === 'ArrowRight') showImage(currentIndex + 1);
		}, { capture: true, signal });
		signal.addEventListener('abort', () => { closeLightbox(); lightbox?.remove(); }, { once: true });
	});
</script>

<style>
	.article-content { font-size: 18px; line-height: 2.08; }
	.article-content :global(p) { margin: 0 0 1.35em; }
	.article-content :global(h2), .article-content :global(h3) { position: relative; }
	.article-content :global(h2) { margin: 2.35em 0 .72em; font-size: 1.55em; line-height: 1.38; scroll-margin-top: 95px; letter-spacing: 0; }
	.article-content :global(h3) { margin: 1.9em 0 .56em; font-size: 1.2em; line-height: 1.5; scroll-margin-top: 95px; }
	.article-content :global(.heading-anchor) { opacity: 0; margin-left: 10px; border: 0; background: transparent; color: var(--muted); font: .55em var(--mono); cursor: pointer; transition: opacity 160ms ease, color 160ms ease; }
	.article-content :global(h2:hover .heading-anchor), .article-content :global(h3:hover .heading-anchor), .article-content :global(.heading-anchor:focus-visible) { opacity: 1; }
	.article-content :global(.heading-anchor:hover) { color: var(--accent); }
	.article-content :global(a) { color: var(--accent); text-decoration: underline; text-decoration-color: var(--accent-soft); text-underline-offset: 3px; transition: text-decoration-color 160ms ease, color 160ms ease; }
	.article-content :global(a:hover) { text-decoration-color: currentColor; }
	.article-content :global(code) { padding: 2px 5px; background: var(--code-bg); border-radius: 4px; font: .82em var(--mono); }
	.article-content :global(blockquote) { margin: 2.15em 0; padding: .25em 1.35em; border-left: 1px solid var(--accent); color: var(--muted); font-size: 1.08em; background: color-mix(in srgb, var(--surface) 38%, transparent); }
	.article-content :global(ul), .article-content :global(ol) { padding-left: 1.45em; margin: 0 0 1.15em; }
	.article-content :global(li) { padding-left: .35em; margin: .18em 0; }
	.article-content :global(hr) { border: 0; width: 42%; border-top: 1px solid var(--line); margin: 3.2em auto; }
	.article-content :global(.article-image) { width: min(920px, calc(100vw - 48px)); margin: 2.45em 0 2.55em 50%; transform: translateX(-50%); }
	.article-content :global(.article-image img) { display: block; width: 100%; height: auto; max-height: 820px; object-fit: contain; background: var(--surface); cursor: zoom-in; transition: transform 180ms ease, filter 180ms ease; }
	.article-content :global(.article-image img:hover) { transform: scale(1.02); filter: saturate(1.04) contrast(1.02); }
	.article-content :global(figcaption) { margin-top: 9px; color: var(--muted); font: 11px/1.7 var(--mono); letter-spacing: .04em; }
	.article-content :global(.image-gallery) { width: min(920px, calc(100vw - 48px)); margin: 2.45em 0 2.55em 50%; transform: translateX(-50%); display: grid; gap: 12px; align-items: start; }
	.article-content :global(.image-gallery-2) { grid-template-columns: repeat(2, 1fr); }
	.article-content :global(.image-gallery-3), .article-content :global(.image-gallery-4) { grid-template-columns: repeat(3, 1fr); }
	.article-content :global(.image-gallery .article-image) { width: 100%; margin: 0; transform: none; }
	.article-content :global(.image-gallery .article-image img) { aspect-ratio: 4 / 5; height: 100%; object-fit: cover; }
	.article-content :global(.callout) { display: flex; gap: 12px; padding: 16px 18px; margin: 1.9em 0; background: color-mix(in srgb, var(--surface) 82%, transparent); font-size: .94em; line-height: 1.85; border-radius: var(--radius); }
	.article-content :global(.callout span) { flex: 0 0 auto; }
	.article-content :global(.code-wrap) { position: relative; margin: 1.8em 0; }
	.article-content :global(pre) { overflow-x: auto; padding: 22px; background: #27231d; color: #f7f1e8; line-height: 1.75; border-radius: var(--radius); }
	.article-content :global(pre code) { padding: 0; background: none; color: inherit; }
	.article-content :global(.copy-code) { position: absolute; right: 8px; top: 8px; padding: 5px 8px; border: 1px solid #ffffff33; border-radius: 4px; background: #00000033; color: #fff; font: 11px var(--mono); cursor: pointer; }
	.article-content :global(.embed-link) { display: inline-block; padding: 9px 14px; border: 1px solid var(--line); text-decoration: none; font: 12px var(--mono); border-radius: var(--radius); }
	.article-content :global(.media-embed) { margin: 2em 0; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
	.article-content :global(.media-embed iframe) { display: block; width: 100%; border: 0; }
	.article-content :global(.media-embed-youtube iframe) { aspect-ratio: 16 / 9; height: auto; }
	.article-content :global(.media-embed-spotify iframe) { height: 152px; }
	.article-content :global(.media-embed-apple iframe) { height: 175px; }
	.article-content :global(.notion-columns) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 22px; align-items: start; margin: 1.8em 0; }
	.article-content :global(.notion-column) { min-width: 0; }
	.article-content :global(.notion-column > .article-image) { width: 100%; margin: 0; transform: none; }
	.article-content :global(.notion-column > :first-child) { margin-top: 0; }
	.article-content :global(.notion-column > :last-child) { margin-bottom: 0; }
	.article-content :global(details) { margin: 1.2em 0; padding: 12px 14px; background: var(--surface); border-radius: var(--radius); }
	.article-content :global(summary) { cursor: pointer; }
	.article-content :global(.todo) { display: flex; gap: 8px; align-items: baseline; }
	.article-content :global(.table-wrap) { overflow-x: auto; margin: 2em 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	.article-content :global(table) { width: 100%; border-collapse: collapse; min-width: 520px; }
	.article-content :global(td) { border: 0; border-bottom: 1px solid var(--line); padding: 12px 14px; vertical-align: top; }
	:global(.has-lightbox) { overflow: hidden; }
	:global(.lightbox) { position: fixed; inset: 0; z-index: 100; display: grid; grid-template-columns: 72px 1fr 72px; align-items: center; gap: 10px; padding: 28px; background: color-mix(in srgb, var(--paper) 92%, #000 8%); opacity: 0; pointer-events: none; transition: opacity 180ms ease; }
	:global(.lightbox.is-open) { opacity: 1; pointer-events: auto; }
	:global(.lightbox figure) { min-width: 0; margin: 0; text-align: center; }
	:global(.lightbox img) { max-width: 100%; max-height: calc(100vh - 110px); object-fit: contain; }
	:global(.lightbox figcaption) { margin-top: 10px; color: var(--muted); font: 11px/1.7 var(--mono); }
	:global(.lightbox button) { border: 0; background: transparent; color: var(--muted); cursor: pointer; transition: color 160ms ease; }
	:global(.lightbox button:hover) { color: var(--accent); }
	:global(.lightbox-close) { position: absolute; top: 20px; right: 24px; font-size: 28px; }
	:global(.lightbox-prev), :global(.lightbox-next) { font-size: 42px; }
	@media (max-width: 640px) {
		.article-content { font-size: 16px; line-height: 1.98; }
		.article-content :global(.article-image), .article-content :global(.image-gallery) { width: 100%; margin-left: 0; transform: none; }
		.article-content :global(.image-gallery) { grid-template-columns: 1fr; }
		.article-content :global(.image-gallery .article-image img) { aspect-ratio: auto; height: auto; object-fit: contain; }
		:global(.lightbox) { grid-template-columns: 1fr; padding: 18px; }
		:global(.lightbox-prev), :global(.lightbox-next) { display: none; }
	}
</style>
