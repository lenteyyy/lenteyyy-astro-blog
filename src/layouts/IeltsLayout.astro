---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/600.css';
import '@fontsource/noto-sans-sc/700.css';
import { canonicalUrl } from '../lib/site';
import LegalLinks from '../components/ielts/LegalLinks.astro';

const {
	title = 'Lenteyyy IELTS',
	description = '课程预约、雅思学习资料与模考入口。',
	telemetry = true,
	legalLinks = true,
} = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
---
<!doctype html>
<html lang="zh-CN" data-ielts-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="512x512" href="/lenteyyy-logo.png" />
		<link rel="apple-touch-icon" sizes="512x512" href="/lenteyyy-logo.png" />
		<meta property="og:site_name" content="Lenteyyy IELTS" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
		<script is:inline>
			try {
				const saved = localStorage.getItem('ielts-theme');
				const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.ieltsTheme = saved === 'dark' || (!saved && systemDark) ? 'dark' : 'light';
			} catch {}
		</script>
	</head>
	<body class="ielts-site">
		<slot />
		{legalLinks && <LegalLinks />}
		{telemetry && <Analytics />}
		{telemetry && <SpeedInsights />}
	</body>
</html>

<style is:global>
	@keyframes page-in { from { opacity: 0; transform: translateY(7px); } }
	:root {
		color-scheme: light;
		--ielts-bg: #ffffff;
		--ielts-panel: #f7f7f7;
		--ielts-card: #ffffff;
		--ielts-ink: #111111;
		--ielts-text: #333333;
		--ielts-muted: #707070;
		--ielts-faint: #9a9a9a;
		--ielts-line: #e3e3e3;
		--ielts-accent: #181818;
		--ielts-accent-soft: #ededed;
		--ielts-hover: #f3f3f3;
		--ielts-shadow: 0 14px 45px #0000000c;
		--ielts-radius: 6px;
		font-family: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
	}
	:root[data-ielts-theme='dark'] {
		color-scheme: dark;
		--ielts-bg: #111111;
		--ielts-panel: #191919;
		--ielts-card: #151515;
		--ielts-ink: #f5f5f5;
		--ielts-text: #d4d4d4;
		--ielts-muted: #a1a1a1;
		--ielts-faint: #777777;
		--ielts-line: #333333;
		--ielts-accent: #ededed;
		--ielts-accent-soft: #282828;
		--ielts-hover: #242424;
		--ielts-shadow: 0 24px 70px #00000045;
	}
	* { box-sizing: border-box; }
	[hidden] { display: none !important; }
	html { scroll-behavior: smooth; }
	body.ielts-site { margin: 0; min-width: 320px; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; background: var(--ielts-bg); color: var(--ielts-text); text-rendering: optimizeLegibility; animation: page-in .24s cubic-bezier(.2,.75,.25,1); }
	.ielts-site > main { flex: 1; }
	.ielts-site a { color: inherit; text-decoration: none; }
	.ielts-site button, .ielts-site input, .ielts-site textarea { font: inherit; }
	.ielts-site button, .ielts-site a { -webkit-tap-highlight-color: transparent; }
	.ielts-site img { max-width: 100%; }
	.ielts-site :focus-visible { outline: 3px solid color-mix(in srgb, var(--ielts-accent) 62%, transparent); outline-offset: 3px; }
	.ielts-site ::selection { background: var(--ielts-accent-soft); color: var(--ielts-ink); }
	@media (prefers-reduced-motion: reduce) {
		body.ielts-site { animation: none; }
	}
</style>
