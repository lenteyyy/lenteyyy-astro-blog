---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/motion.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import NavIndicator from '../components/NavIndicator.astro';
import { canonicalUrl, site } from '../lib/site';
import { localizedPath, type SiteLocale } from '../lib/locale';

const {
	title = site.title,
	description = site.description,
	image = site.defaultOgImage,
	type = 'website',
	publishedAt,
	updatedAt,
	noindex = false,
	locale = 'zh-CN' as SiteLocale,
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = canonicalUrl(currentPath);
const imageUrl = image.startsWith('http') ? image : canonicalUrl(image);
const imageIsPng = new URL(imageUrl).pathname.endsWith('.png');
const pathWithoutLocale = localizedPath(locale === 'zh-TW' ? currentPath.replace(/^\/zh-tw/, '') || '/' : currentPath, 'zh-CN');
const path = (value: string) => localizedPath(value, locale);
const simplifiedUrl = canonicalUrl(pathWithoutLocale);
const traditionalUrl = canonicalUrl(localizedPath(pathWithoutLocale, 'zh-TW'));
---
<!doctype html>
<html lang={locale} transition:animate={fade({ duration: '180ms' })}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="zh-CN" href={simplifiedUrl} />
		<link rel="alternate" hreflang="zh-TW" href={traditionalUrl} />
		<link rel="icon" type="image/png" sizes="512x512" href="/lenteyyy-logo.png" />
		<link rel="apple-touch-icon" sizes="512x512" href="/lenteyyy-logo.png" />
		<link rel="alternate" type="application/rss+xml" title="Lenteyyy RSS" href={path('/rss.xml')} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={title} />
		{imageIsPng && <meta property="og:image:type" content="image/png" />}
		{imageIsPng && <meta property="og:image:width" content="1200" />}
		{imageIsPng && <meta property="og:image:height" content="630" />}
		<meta property="og:locale" content={locale === 'zh-TW' ? 'zh_TW' : site.locale} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={title} />
		{publishedAt && <meta property="article:published_time" content={publishedAt} />}
		{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
		<title>{title}</title>
		<ClientRouter />
		<script is:inline src="/theme-init.js"></script>
	</head>
	<body data-site-motion="on">
		<header class="site-header" transition:name="blog-header" transition:animate="none">
			<div class="shell nav-wrap">
				<a class="brand" href={path('/')} aria-label={locale === 'zh-TW' ? 'Lenteyyy 首頁' : 'Lenteyyy 首页'}><img class="brand-logo" src="/brand-sheep-transparent.webp" width="48" height="48" alt="" decoding="async" /><span class="brand-name">Lenteyyy</span></a>
				<nav data-primary-nav aria-label={locale === 'zh-TW' ? '主導航' : '主导航'}>
					<a class={pathWithoutLocale === '/' ? 'active' : ''} aria-current={pathWithoutLocale === '/' ? 'page' : undefined} href={path('/')}>{locale === 'zh-TW' ? '首頁' : '首页'}</a>
					<a class={pathWithoutLocale.startsWith('/posts') || pathWithoutLocale.startsWith('/tags') ? 'active' : ''} aria-current={pathWithoutLocale.startsWith('/posts') || pathWithoutLocale.startsWith('/tags') ? 'page' : undefined} href={path('/posts')}>{locale === 'zh-TW' ? '文章' : '文章'}</a>
					<a class={pathWithoutLocale === '/about' ? 'active' : ''} aria-current={pathWithoutLocale === '/about' ? 'page' : undefined} href={path('/about')}>{locale === 'zh-TW' ? '關於' : '关于'}</a>
					<NavIndicator />
					<LanguageToggle locale={locale} />
					<ThemeToggle />
				</nav>
			</div>
		</header>
		<main><slot /></main>
		<footer class="site-footer">
			<div class="shell footer-inner">
				<span>© {new Date().getFullYear()} Lenteyyy</span>
				<nav class="footer-links" aria-label={locale === 'zh-TW' ? '聯絡方式' : '联系方式'}>
					<a href="https://github.com/lenteyyy" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="https://lenteyielts.cn/" target="_blank" rel="noopener noreferrer">{locale === 'zh-TW' ? '冷踢踢的雅思學習網站' : '冷踢踢的雅思学习网站'}</a>
				</nav>
			</div>
		</footer>
		<div class="easter-egg" data-easter-egg hidden role="dialog" aria-modal="true" aria-labelledby="easter-egg-title">
			<div class="easter-egg-card"><button type="button" class="easter-egg-close" data-easter-egg-close aria-label={locale === 'zh-TW' ? '關閉' : '关闭'}>×</button><p id="easter-egg-title">{locale === 'zh-TW' ? '恭喜你發現了這個彩蛋！附上全世界最好喝的手搖飲之相片一張。' : '恭喜你发现了这个彩蛋！附上全世界最好喝的手摇饮之相片一张。'}</p><img src="/assets/egg-tea.png" alt={locale === 'zh-TW' ? '手搖飲照片' : '手摇饮照片'} /></div>
		</div>
		<script>
			import '../lib/site-motion';
			import { onPageLoad } from '../lib/client-lifecycle';
			onPageLoad('easter-egg', (signal) => {
				const egg = document.querySelector<HTMLElement>('[data-easter-egg]');
				const eggClose = document.querySelector<HTMLButtonElement>('[data-easter-egg-close]');
				let sevenCount = 0;
				let opener: HTMLElement | null = null;
				const close = () => {
					if (!egg || egg.hidden) return;
					egg.hidden = true;
					document.documentElement.classList.remove('has-easter-egg');
					if (!signal.aborted) opener?.focus({ preventScroll: true });
				};
				document.addEventListener('keydown', (event) => {
					if (egg && !egg.hidden) {
						if (event.key === 'Escape') { event.preventDefault(); event.stopImmediatePropagation(); close(); }
						if (event.key === 'Tab') { event.preventDefault(); eggClose?.focus(); }
						return;
					}
					if (event.repeat || event.ctrlKey || event.metaKey || event.altKey || document.documentElement.classList.contains('has-lightbox') || (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable]'))) { sevenCount = 0; return; }
					if (!event.shiftKey || event.code !== 'Digit7') { if (event.key !== 'Shift') sevenCount = 0; return; }
					sevenCount += 1;
					if (sevenCount === 3 && egg) { opener = document.activeElement instanceof HTMLElement ? document.activeElement : null; egg.hidden = false; sevenCount = 0; document.documentElement.classList.add('has-easter-egg'); eggClose?.focus(); }
				}, { capture: true, signal });
				eggClose?.addEventListener('click', close, { signal });
				egg?.addEventListener('click', (event) => { if (event.target === egg) close(); }, { signal });
				signal.addEventListener('abort', close, { once: true });
			});
		</script>
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;500;600;700&display=swap');
	:root {
		color-scheme: light;
		--serif: 'Noto Serif SC', Georgia, serif;
		--mono: 'DM Mono', ui-monospace, monospace;
		--ink: #26231f;
		--muted: #756e63;
		--soft: #766f64;
		--line: #e4ddd2;
		--paper: #f8f5ef;
		--surface: #efebe2;
		--accent: #9d4a3d;
		--accent-soft: #d8a096;
		--white: #fffdf8;
		--code-bg: #ebe5da;
		--radius: 3px;
		--shadow: 0 18px 45px color-mix(in srgb, var(--ink) 8%, transparent);
		font-family: var(--serif);
		font-size: 106.25%;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) {
			color-scheme: dark;
			--ink: #efe9df;
			--muted: #aaa197;
			--soft: #8b8277;
			--line: #383229;
			--paper: #15130f;
			--surface: #211d18;
			--accent: #d69386;
			--accent-soft: #74483e;
			--white: #1b1813;
			--code-bg: #28231d;
			--shadow: 0 18px 45px #00000040;
		}
	}
	:root[data-theme='dark'] {
		color-scheme: dark;
		--ink: #efe9df;
		--muted: #aaa197;
		--soft: #8b8277;
		--line: #383229;
		--paper: #15130f;
		--surface: #211d18;
		--accent: #d69386;
		--accent-soft: #74483e;
		--white: #1b1813;
		--code-bg: #28231d;
		--shadow: 0 18px 45px #00000040;
	}
	* { box-sizing: border-box; }
	html { scrollbar-gutter: stable; }
	body { margin: 0; background: var(--paper); color: var(--ink); text-rendering: optimizeLegibility; }
	html[data-astro-transition] body { animation: none; }
	nav > a::after { transition: transform var(--motion-duration) var(--motion-ease); }
	a { color: inherit; text-decoration: none; }
	img { max-width: 100%; }
	button, input { font: inherit; }
	:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
	::selection { background: var(--accent-soft); color: var(--ink); }
	.shell { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }
	.site-header { border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent); background: color-mix(in srgb, var(--paper) 91%, transparent); position: sticky; top: 0; z-index: 10; backdrop-filter: blur(16px); }
	.nav-wrap, .footer-inner { min-height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
	.brand { display: inline-flex; align-items: center; flex-shrink: 0; gap: 12px; font-size: 1.25rem; font-weight: 700; letter-spacing: .01em; transition: color 180ms ease; }
	.brand-logo { display: block; width: 48px; height: 48px; flex-shrink: 0; object-fit: contain; background: transparent; }
	.brand:hover { color: var(--accent); }
	nav { display: flex; align-items: center; gap: 26px; color: var(--muted); font-size: 0.875rem; }
	[data-primary-nav] { position: relative; }
	nav > a { position: relative; padding: 24px 0 22px; transition: color 180ms ease; }
	nav > a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 15px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; }
	nav > a:hover, nav > a.active { color: var(--ink); }
	nav > a:hover::after, nav > a.active::after { transform: scaleX(1); }
	.site-footer { margin-top: 120px; color: var(--muted); font: 0.75rem/1.6 var(--mono); }
	.footer-inner { min-height: 84px; border-top: 1px solid color-mix(in srgb, var(--line) 72%, transparent); }
	.footer-links { display: flex; flex-wrap: wrap; gap: 0 20px; font: 0.75rem/1.8 var(--mono); }
	.footer-links a { padding: 14px 0; color: var(--muted); transition: color 180ms ease; }
	.footer-links a:hover { color: var(--accent); }
	.easter-egg { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 22px; background: #0009; }
	.easter-egg[hidden] { display: none; }
	html.has-easter-egg { overflow: hidden; }
	.easter-egg-card { position: relative; width: min(560px, 100%); padding: 28px; background: var(--paper); color: var(--ink); box-shadow: var(--shadow); }
	.easter-egg-card p { margin: 0 30px 22px 0; font-size: 1.125rem; line-height: 1.8; }
	.easter-egg-card img { display: block; width: 100%; max-height: 65vh; object-fit: cover; }
	.easter-egg-close { position: absolute; top: 10px; right: 14px; border: 0; background: transparent; color: var(--muted); font-size: 1.625rem; cursor: pointer; }
	@media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .article-content img, :root:not([data-theme='light']) .hero-image { filter: brightness(.9); } }
	:root[data-theme='dark'] .article-content img, :root[data-theme='dark'] .hero-image { filter: brightness(.9); }
	@media (max-width: 640px) {
		.shell { width: min(1180px, calc(100% - 30px)); }
		.nav-wrap { min-height: 62px; }
		.brand { font-size: 1.125rem; }
		.brand-name { display: none; }
		.brand-logo { width: 44px; height: 44px; }
		nav { gap: 14px; font-size: 0.8125rem; }
		nav > a { padding: 20px 0 17px; }
		.footer-inner { align-items: flex-start; flex-direction: column; justify-content: center; gap: 12px; }
		.footer-links { gap: 14px; flex-wrap: wrap; }
	}
	@media (max-width: 380px) {
		.nav-wrap { gap: 12px; }
		.nav-wrap > nav { gap: 9px; }
	}
</style>
