---
import IeltsLayout from './IeltsLayout.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<IeltsLayout title={`${title} · 冷踢踢 IELTS`} description={description} telemetry={false}>
	<main class="legal-page">
		<a class="return-link" href="/ielts">冷踢踢 IELTS</a>
		<header><h1>{title}</h1><p class="updated">生效日期：2026 年 10 月 5 日</p></header>
		<article><slot /></article>
	</main>
</IeltsLayout>

<style is:global>
	.legal-page { width: min(760px, calc(100% - 40px)); margin: clamp(32px, 7vw, 88px) auto 32px; }
	.legal-page .return-link { color: var(--ielts-muted); font-size: .9375rem; }
	.legal-page header { margin: 36px 0; padding-bottom: 24px; border-bottom: 1px solid var(--ielts-line); }
	.legal-page h1 { margin: 0 0 14px; color: var(--ielts-ink); font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.3; }
	.legal-page .updated { margin: 0; color: var(--ielts-muted); font-size: .875rem; }
	.legal-page article { font-size: 1rem; line-height: 1.9; overflow-wrap: anywhere; }
	.legal-page h2 { margin: 30px 0 10px; color: var(--ielts-ink); font-size: 1.125rem; line-height: 1.6; }
	.legal-page p { margin: 0 0 16px; }
	.legal-page article a { text-decoration: underline; text-underline-offset: 4px; }
</style>
