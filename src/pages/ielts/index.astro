	.side-nav { display: grid; gap: 7px; margin-top: 44px; }
	.side-nav a { min-height: 52px; display: flex; align-items: center; gap: 14px; padding: 0 16px; border-radius: 10px; color: var(--ielts-text); font-size: 16px; font-weight: 500; transition: color .16s ease, background .16s ease; }
	.side-nav a:hover, .side-nav a.active { color: var(--ielts-ink); background: var(--ielts-accent-soft); }
	.side-nav :global(svg) { flex: 0 0 auto; }
	.side-footer { display: grid; gap: 14px; margin-top: auto; }
	.account-menu { position: relative; }
	.account-button, .management-link, .back-home { min-height: 46px; display: flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid var(--ielts-accent); border-radius: 10px; background: transparent; color: var(--ielts-ink); cursor: pointer; font-size: 14px; font-weight: 500; }
	.account-button { width: 100%; }
	.account-panel { position: absolute; z-index: 12; right: 0; bottom: calc(100% + 9px); left: 0; display: grid; gap: 8px; padding: 12px; border: 1px solid var(--ielts-line); border-radius: 11px; background: var(--ielts-card); box-shadow: var(--ielts-shadow); animation: account-in .18s ease both; }
	.account-panel > span { overflow: hidden; color: var(--ielts-muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
	.account-panel > button { min-height: 38px; border: 1px solid var(--ielts-line); border-radius: 8px; background: var(--ielts-panel); color: var(--ielts-ink); cursor: pointer; font-size: 12px; }
	.account-panel [data-account-logout] { border-color: color-mix(in srgb, #b55252 48%, var(--ielts-line)); color: #b55252; }
	.management-link[hidden] { display: none; }
	.back-home :global(svg) { transform: rotate(180deg); }
	.theme-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 5px; border: 1px solid var(--ielts-line); border-radius: 999px; }
	.theme-choices button { min-height: 32px; display: flex; align-items: center; justify-content: center; gap: 6px; border: 0; border-radius: 999px; background: transparent; color: var(--ielts-muted); cursor: pointer; font-size: 12px; white-space: nowrap; }
	.theme-choices button[aria-pressed='true'] { background: var(--ielts-accent-soft); color: var(--ielts-ink); }
	.work-area { min-width: 0; padding: 20px; }
	.mobile-heading { display: none; }
	.dashboard { display: grid; }
	.module { min-width: 0; padding: 24px; scroll-margin-top: 24px; border: 1px solid var(--ielts-line); border-radius: var(--ielts-radius); background: var(--ielts-card); }
	.module.section-enter { animation: section-in .24s cubic-bezier(.2,.75,.25,1) both; }
	.module[hidden] { display: none; }
	@keyframes section-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes account-in { from { opacity: 0; transform: translateY(5px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
	.overview-module { min-height: calc(100dvh - 82px); }
	.overview-copy { width: min(780px, 100%); display: grid; align-content: start; gap: 30px; padding: clamp(12px, 3vw, 42px) 0; }
	.overview-copy > p, .overview-copy section { margin: 0; padding: clamp(22px, 3vw, 34px); border: 1px solid var(--ielts-line); border-radius: 12px; background: var(--ielts-panel); color: var(--ielts-text); font-size: clamp(15px, 1.4vw, 18px); line-height: 2; }
	.overview-copy section h2 { margin: 0 0 14px; color: var(--ielts-ink); font-size: clamp(20px, 2vw, 27px); }
	.overview-copy section p { margin: 0; }
	.module-head { min-height: 50px; display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
	.module-head h1, .module-head h2 { margin: 0; color: var(--ielts-ink); font-size: clamp(25px, 2.2vw, 36px); font-weight: 700; letter-spacing: -.035em; line-height: 1.2; }
	.module-head h1 span, .module-head h2 span { margin-right: 16px; color: var(--ielts-faint); font-size: .84em; font-style: italic; font-weight: 400; }
	.module-head a { display: flex; align-items: center; gap: 8px; color: var(--ielts-accent); font-size: 13px; font-weight: 500; }
	.module-state { color: var(--ielts-muted); font-size: 13px; }
	.booking-grid { display: grid; grid-template-columns: minmax(340px, 1.08fr) minmax(210px, .62fr) minmax(280px, .86fr); gap: 12px; align-items: stretch; }
	.booking-column { min-width: 0; border: 1px solid var(--ielts-line); border-radius: 11px; background: var(--ielts-panel); }
	.booking-column > h2 { margin: 0 0 17px; color: var(--ielts-ink); font-size: 17px; }
	.calendar-card { padding: 16px; }
	.calendar-head { display: grid; grid-template-columns: 34px 1fr 34px; align-items: center; margin-bottom: 13px; }
	.calendar-head strong { text-align: center; color: var(--ielts-ink); font-size: 16px; font-weight: 600; }
	.calendar-head button { width: 34px; height: 34px; border: 0; background: transparent; color: var(--ielts-ink); cursor: pointer; font-size: 24px; }
	.calendar-head button:disabled { opacity: .22; cursor: not-allowed; }
	.week-row, .calendar-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
	.week-row { margin-bottom: 5px; color: var(--ielts-muted); text-align: center; font-size: 11px; }
	.calendar-days :global(button) { aspect-ratio: 1; min-width: 0; border: 0; border-radius: 50%; background: transparent; color: var(--ielts-text); cursor: pointer; font-size: 12px; }
	.calendar-days :global(button:hover:not(:disabled)), .calendar-days :global(button.selected) { background: var(--ielts-accent); color: #fff; }
	.calendar-days :global(button.outside) { color: var(--ielts-faint); }
	.calendar-days :global(button:disabled) { opacity: .25; cursor: not-allowed; }
	.time-card { display: flex; flex-direction: column; gap: 13px; padding: 17px; }
	.field-label { display: block; margin-bottom: 6px; color: var(--ielts-muted); font-size: 11px; font-weight: 600; letter-spacing: .09em; }
	.time-card strong { display: block; min-height: 24px; color: var(--ielts-ink); font-size: 14px; line-height: 1.7; }
	.time-slots { display: grid; gap: 8px; }
