---
import IeltsIcon from '../../components/ielts/IeltsIcon.astro';
import IeltsLayout from '../../layouts/IeltsLayout.astro';

const resources = [
	{ icon: 'headphones' as const, title: '听力', lines: ['真题精听', '场景词汇'] },
	{ icon: 'book' as const, title: '阅读', lines: ['题型解析', '长难句整理'] },
	{ icon: 'pen' as const, title: '写作', lines: ['思路拆解', '高分表达'] },
	{ icon: 'chat' as const, title: '口语', lines: ['话题素材', '逻辑表达'] },
];

const notes = [
	{ icon: 'user' as const, title: '一对一课程', text: '提交时间意向后，我会再与你确认。' },
	{ icon: 'file' as const, title: '登录后查看资料', text: '资料储存在私有空间，只向已验证学员开放。' },
	{ icon: 'calendar' as const, title: '时间需要预约', text: '页面显示的是时间意向，不代表预约已确认。' },
	{ icon: 'info' as const, title: '邮箱与密码登录', text: '首次设置或忘记密码时，邮箱会收到六位验证码。' },
];
---
<IeltsLayout title="Lenteyyy IELTS · 学习与课程" description="课程预约、雅思学习资料与模考入口。">
	<div class="ielts-app" data-ielts-page>
		<aside class="side-panel">
			<a class="studio-brand" href="/ielts" aria-label="Lenteyyy IELTS 首页">
				<span class="logo-frame"><img src="/lenteyyy-logo.png" alt="Lenteyyy" width="512" height="512" /></span>
				<span>IELTS STUDY DESK</span>
			</a>

			<nav class="side-nav" aria-label="雅思学习中心导航">
				<a class="active" href="#overview"><IeltsIcon name="home" />我的个人简介</a>
				<a href="#booking"><IeltsIcon name="calendar" />课程预约</a>
				<a href="#materials"><IeltsIcon name="folder" />学习资料</a>
				<a href="#mock"><IeltsIcon name="clipboard" />模考页面</a>
				<a href="#notes"><IeltsIcon name="info" />其他信息</a>
			</nav>

			<div class="side-footer">
				<div class="account-menu" data-account-menu>
					<button class="account-button" type="button" data-account-button aria-expanded="false"><IeltsIcon name="user" size={18} />个人账户</button>
					<div class="account-panel" data-account-panel hidden>
						<span data-account-email>尚未登录</span>
						<button type="button" data-account-login>登录或注册</button>
						<button type="button" data-account-logout hidden>退出登录</button>
					</div>
				</div>
				<a class="management-link" href="/ielts/management" data-management-link hidden><IeltsIcon name="clipboard" size={18} />管理后台</a>
				<a class="back-home" href="/"><IeltsIcon name="arrow" />回到主站</a>
				<div class="theme-choices" aria-label="页面配色">
					<button type="button" data-theme-choice="light" aria-pressed="true"><IeltsIcon name="sun" size={17} />浅色</button>
					<button type="button" data-theme-choice="dark" aria-pressed="false"><IeltsIcon name="moon" size={17} />深色</button>
				</div>
			</div>
		</aside>

		<main class="work-area">
			<div class="mobile-heading">
				<span>IELTS STUDY DESK</span>
				<a href="/">回到主站</a>
			</div>

			<div class="dashboard">
				<section class="module overview-module" id="overview">
					<header class="module-head">
						<h1>Introduction</h1>
					</header>
					<div class="overview-copy">
						<p>你好！我是雅思 Overall 8.0 的冷踢踢老师，欢迎来到冷踢踢的雅思学习网站！这里主要为我的学员提供课程线上预约、学习资料查询与整理、仿真模考等服务。如果你是通过其他途径来到这里的雅思学习者，也非常欢迎你注册登录，并免费使用网站内开放的学习功能。</p>
						<section>
							<h2>网站使用说明</h2>
							<p>使用前，请先在左下角完成注册或登录。为保障账户安全，注册或登录过程中可能需要通过电子邮箱接收验证码。登录后，可以通过左侧导航栏进入需要的功能页面。更多使用说明及 IELTS 学习工具，请参照左侧的「其他信息」。</p>
						</section>
					</div>
				</section>

				<section class="module booking-module" id="booking" hidden>
					<header class="module-head">
						<h1>课程预约</h1>
						<a href="#notes" data-section-target="notes">预约规则<IeltsIcon name="arrow" size={18} /></a>
					</header>

					<div class="booking-grid">
						<div class="calendar-card booking-column" data-booking-calendar>
							<h2>选择日期</h2>
							<div class="calendar-head">
								<button type="button" data-calendar-prev aria-label="上个月">‹</button>
								<strong data-calendar-title></strong>
								<button type="button" data-calendar-next aria-label="下个月">›</button>
							</div>
							<div class="week-row" aria-hidden="true"><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div>
							<div class="calendar-days" data-calendar-days></div>
						</div>

						<div class="time-card booking-column">
							<h2>选择时间段</h2>
							<div>
								<span class="field-label">上课日期</span>
								<strong data-selected-date>请选择日期</strong>
							</div>
							<div class="time-slots" aria-label="时间意向">
								<button type="button" data-time="8:30–10:00" aria-pressed="false">8:30–10:00</button>
								<button type="button" data-time="10:30–12:00" aria-pressed="false">10:30–12:00</button>
								<button type="button" data-time="19:00–20:30" aria-pressed="false">19:00–20:30</button>
								<button type="button" data-time="21:00–22:30" aria-pressed="false">21:00–22:30</button>
								<button type="button" data-time="其他时间" aria-pressed="false">其他时间</button>
							</div>
							<p class="booking-status" data-booking-status aria-live="polite">选择日期与时间后即可填写。</p>
						</div>

						<form class="booking-form-card booking-column" data-booking-form>
							<h2>预约信息</h2>
							<p class="dialog-selection" data-booking-selection>请选择日期与时间。</p>
							<label>科目<select name="subject" required><option value="">请选择科目</option><option>听力</option><option>阅读</option><option>写作</option><option>口语</option></select></label>
							<label>你的称呼<input name="name" autocomplete="name" maxlength="60" required /></label>
							<label>微信或其他联系方式（选填）<input name="contact" autocomplete="off" maxlength="120" /></label>
							<label>补充说明（选填）<textarea name="note" rows="3" maxlength="500"></textarea></label>
							<label class="consent-row"><input type="checkbox" name="consent" required />我同意仅为预约、确认与课程联络储存以上资料。</label>
							<p class="privacy-note">登录邮箱会随预约保存；你可通过主站邮箱申请查询或删除。</p>
							<p class="form-message" data-booking-message aria-live="polite"></p>
							<button class="booking-action" type="submit" data-open-booking disabled>提交预约<IeltsIcon name="arrow" size={18} /></button>
						</form>
					</div>
					<section class="booking-list-section" aria-labelledby="my-bookings-title">
						<div class="booking-list-head"><h2 id="my-bookings-title">我的预约</h2><span data-booking-list-state>登录后查看</span></div>
						<div class="booking-list" data-booking-list><p>登录后可查看和取消预约。</p></div>
					</section>
				</section>

				<section class="module resources-module" id="materials" hidden>
					<header class="module-head">
						<h2>学习资料</h2>
						<span class="module-state" data-material-state>登录后查看</span>
					</header>
					<div class="resource-grid">
						{resources.map((item) => (
							<button class="resource-card" type="button" data-material-category={item.title}>
								<span class="resource-icon"><IeltsIcon name={item.icon} size={27} /></span>
								<div><h3>{item.title}</h3><p>{item.lines[0]}<br />{item.lines[1]}</p></div>
								<IeltsIcon name="arrow" size={18} />
							</button>
						))}
					</div>
					<div class="small-resources">
						<div class="material-list-head"><span>资料列表</span></div>
						<div class="material-list" data-material-list><p>登录后可查看与下载学习资料。</p></div>
					</div>
				</section>

				<section class="module mock-module" id="mock" hidden>
					<header class="module-head">
						<h2>模考页面</h2>
						<span class="module-state">内容待导入</span>
					</header>
					<div class="mock-tabs" role="tablist" aria-label="模考科目">
						<button type="button" class="active" data-mock="Listening" role="tab" aria-selected="true"><IeltsIcon name="headphones" size={19} />Listening</button>
						<button type="button" data-mock="Reading" role="tab" aria-selected="false"><IeltsIcon name="book" size={19} />Reading</button>
						<button type="button" data-mock="Writing" role="tab" aria-selected="false"><IeltsIcon name="pen" size={19} />Writing</button>
						<button type="button" data-mock="Speaking" role="tab" aria-selected="false"><IeltsIcon name="chat" size={19} />Speaking</button>
					</div>
					<div class="mock-body">
						<div class="mock-poster" aria-hidden="true"><span>FULL</span><strong>TEST</strong><small>01</small></div>
						<div class="mock-copy">
							<p class="field-label">IELTS PRACTICE</p>
							<h3>全真模考 · <span data-mock-title>Listening</span></h3>
							<p>题目与答案会从学习资料库导入；正式开放前不会生成虚假成绩。</p>
							<div class="mock-meta"><span><IeltsIcon name="file" size={19} />40 道题</span><span><IeltsIcon name="calendar" size={19} />30 分钟</span></div>
							<button type="button" disabled>资料加入后开放</button>
						</div>
					</div>
				</section>

				<section class="module notes-module" id="notes" hidden>
					<header class="module-head"><h2>其他信息</h2></header>
					<div class="note-list">
						{notes.map((item, index) => (
							<article id={index === 2 ? 'booking-note' : undefined}>
								<span><IeltsIcon name={item.icon} size={22} /></span>
								<div><h3>{item.title}</h3><p>{item.text}</p></div>
							</article>
						))}
					</div>
				</section>
			</div>
		</main>
	</div>

	<dialog class="booking-dialog auth-dialog" data-auth-dialog aria-labelledby="auth-dialog-title">
		<form data-login-form>
			<div class="dialog-head"><div><span>账户登录</span><h2 id="auth-dialog-title">邮箱与密码</h2></div><button type="button" data-close-auth aria-label="关闭">×</button></div>
			<label>邮箱<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
			<label>密码<input type="password" name="password" autocomplete="current-password" maxlength="72" required /></label>
			<p class="privacy-note">密码由 Supabase 加密管理，本站不会读取或保存明文。</p>
			<p class="form-message" data-auth-message aria-live="polite"></p>
			<button class="dialog-submit" type="submit">登录<IeltsIcon name="arrow" size={18} /></button>
			<button class="auth-switch" type="button" data-open-password-setup>首次设置或忘记密码</button>
		</form>
		<form data-password-form hidden>
			<div class="dialog-head"><div><span>账户验证</span><h2 id="auth-reset-title">设置或重设密码</h2></div><button type="button" data-close-auth aria-label="关闭">×</button></div>
			<label>邮箱<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
			<div data-password-code hidden>
				<p class="dialog-selection" data-auth-email></p>
				<label>六位验证码<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" /></label>
				<label>新密码<input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="72" /></label>
				<label>再次输入新密码<input type="password" name="confirmPassword" autocomplete="new-password" minlength="10" maxlength="72" /></label>
			</div>
			<p class="privacy-note">新密码至少 10 位，并同时包含字母与数字。</p>
			<p class="form-message" data-auth-message aria-live="polite"></p>
			<button class="dialog-submit" type="submit" data-password-submit>发送六位验证码<IeltsIcon name="arrow" size={18} /></button>
			<button class="auth-switch" type="button" data-back-login>返回密码登录</button>
		</form>
	</dialog>

	<script>
		const root = document.querySelector<HTMLElement>('[data-ielts-page]');
		if (root) {
			const themeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
			const setTheme = (theme: 'light' | 'dark', persist = true) => {
				document.documentElement.dataset.ieltsTheme = theme;
				if (persist) try { localStorage.setItem('ielts-theme', theme); } catch {}
				themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme)));
			};
			const initialTheme = document.documentElement.dataset.ieltsTheme === 'dark' ? 'dark' : 'light';
			setTheme(initialTheme, false);
			themeButtons.forEach((button) => button.addEventListener('click', () => setTheme(button.dataset.themeChoice === 'dark' ? 'dark' : 'light')));
			const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
			systemTheme.addEventListener('change', (event) => {
				try { if (!localStorage.getItem('ielts-theme')) setTheme(event.matches ? 'dark' : 'light', false); } catch {}
			});

			const navLinks = [...root.querySelectorAll<HTMLAnchorElement>('.side-nav a')];
			const panels = [...root.querySelectorAll<HTMLElement>('.dashboard > .module')];
			const activateSection = (id: string, updateHash = true) => {
				const next = panels.some((panel) => panel.id === id) ? id : 'overview';
				panels.forEach((panel) => { panel.hidden = panel.id !== next; });
				const activePanel = panels.find((panel) => panel.id === next);
				if (activePanel) {
					activePanel.classList.remove('section-enter');
					requestAnimationFrame(() => activePanel.classList.add('section-enter'));
				}
				navLinks.forEach((link) => {
					const active = link.hash === `#${next}`;
					link.classList.toggle('active', active);
					if (active) link.setAttribute('aria-current', 'page');
					else link.removeAttribute('aria-current');
				});
				if (updateHash) history.replaceState(null, '', `#${next}`);
				window.scrollTo({ top: 0, behavior: 'auto' });
			};
			navLinks.forEach((link) => link.addEventListener('click', (event) => {
				event.preventDefault();
				activateSection(link.hash.slice(1));
			}));
			root.querySelectorAll<HTMLAnchorElement>('[data-section-target]').forEach((link) => link.addEventListener('click', (event) => {
				event.preventDefault();
				activateSection(link.dataset.sectionTarget || 'overview');
			}));
			activateSection(location.hash.slice(1), false);

			const calendarTitle = root.querySelector<HTMLElement>('[data-calendar-title]');
			const calendarDays = root.querySelector<HTMLElement>('[data-calendar-days]');
			const selectedDateLabel = root.querySelector<HTMLElement>('[data-selected-date]');
			const prevButton = root.querySelector<HTMLButtonElement>('[data-calendar-prev]');
			const nextButton = root.querySelector<HTMLButtonElement>('[data-calendar-next]');
			const timeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-time]')];
			const bookingButton = root.querySelector<HTMLButtonElement>('[data-open-booking]');
			const bookingStatus = root.querySelector<HTMLElement>('[data-booking-status]');
			const bookingSelection = root.querySelector<HTMLElement>('[data-booking-selection]');
			const today = new Date();
			today.setHours(0, 0, 0, 0);
			const earliestMonth = new Date(today.getFullYear(), today.getMonth(), 1);
			let visibleMonth = new Date(earliestMonth);
			let selectedDate = '';
			let selectedTime = '';

			const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' });
			const isoDate = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
			const syncBookingButton = () => {
				if (!bookingButton) return;
				bookingButton.disabled = !(selectedDate && selectedTime);
				if (bookingStatus) bookingStatus.textContent = selectedDate && selectedTime ? `${selectedDate} · ${selectedTime}` : '选择日期与时间后即可填写。';
				if (bookingSelection) bookingSelection.textContent = selectedDate && selectedTime ? `${selectedDate} · ${selectedTime}` : '请选择日期与时间。';
			};
			const renderCalendar = () => {
				if (!calendarTitle || !calendarDays) return;
				calendarTitle.textContent = `${visibleMonth.getFullYear()} 年 ${visibleMonth.getMonth() + 1} 月`;
				calendarDays.replaceChildren();
				const firstDay = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth(), 1);
				const mondayOffset = (firstDay.getDay() + 6) % 7;
				const start = new Date(firstDay);
				start.setDate(1 - mondayOffset);
				for (let index = 0; index < 42; index += 1) {
					const date = new Date(start);
					date.setDate(start.getDate() + index);
					const button = document.createElement('button');
					button.type = 'button';
					button.textContent = String(date.getDate());
					button.dataset.date = isoDate(date);
					button.className = date.getMonth() === visibleMonth.getMonth() ? '' : 'outside';
					if (date < today) button.disabled = true;
					if (button.dataset.date === selectedDate) button.classList.add('selected');
					button.setAttribute('aria-label', formatDate(date));
					button.addEventListener('click', () => {
						selectedDate = button.dataset.date || '';
						if (selectedDateLabel) selectedDateLabel.textContent = formatDate(date);
						renderCalendar();
						syncBookingButton();
					});
					calendarDays.append(button);
				}
				if (prevButton) prevButton.disabled = visibleMonth <= earliestMonth;
			};
			prevButton?.addEventListener('click', () => { visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1); renderCalendar(); });
			nextButton?.addEventListener('click', () => { visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1); renderCalendar(); });
			timeButtons.forEach((button) => button.addEventListener('click', () => {
				selectedTime = button.dataset.time || '';
				timeButtons.forEach((item) => { const active = item === button; item.classList.toggle('selected', active); item.setAttribute('aria-pressed', String(active)); });
				syncBookingButton();
			}));
			renderCalendar();

			const mockButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-mock]')];
			const mockTitle = root.querySelector<HTMLElement>('[data-mock-title]');
			mockButtons.forEach((button) => button.addEventListener('click', () => {
				mockButtons.forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-selected', String(active)); });
				if (mockTitle) mockTitle.textContent = button.dataset.mock || 'Listening';
			}));
		}
		</script>
		<script>
			const page = document.querySelector<HTMLElement>('[data-ielts-page]');
			const authDialog = document.querySelector<HTMLDialogElement>('[data-auth-dialog]');
			const bookingForm = page?.querySelector<HTMLFormElement>('[data-booking-form]');
			const accountButton = page?.querySelector<HTMLButtonElement>('[data-account-button]');
			const accountMenu = page?.querySelector<HTMLElement>('[data-account-menu]');
			const accountPanel = page?.querySelector<HTMLElement>('[data-account-panel]');
			const accountEmail = page?.querySelector<HTMLElement>('[data-account-email]');
			const accountLogin = page?.querySelector<HTMLButtonElement>('[data-account-login]');
			const accountLogout = page?.querySelector<HTMLButtonElement>('[data-account-logout]');
			const managementLink = page?.querySelector<HTMLAnchorElement>('[data-management-link]');
			const materialList = page?.querySelector<HTMLElement>('[data-material-list]');
			const materialState = page?.querySelector<HTMLElement>('[data-material-state]');
			const bookingList = page?.querySelector<HTMLElement>('[data-booking-list]');
			const bookingListState = page?.querySelector<HTMLElement>('[data-booking-list-state]');
			let session: { authenticated: boolean; email?: string; role?: 'student' | 'admin' } = { authenticated: false };
			let unavailable = new Map<string, Set<string>>();

			const api = async <T,>(path: string, init?: RequestInit): Promise<T> => {
				const response = await fetch(path, { credentials: 'same-origin', cache: 'no-store', ...init, headers: { 'content-type': 'application/json', ...(init?.headers || {}) } });
				const body = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(String(body.error || `http_${response.status}`));
				return body as T;
			};
			const messageFor = (code: string) => ({
				invalid_email: '请输入有效邮箱。', invalid_code: '验证码错误或已过期。', invalid_password: '密码至少 10 位，并同时包含字母与数字。', password_mismatch: '两次输入的密码不一致。',
				invalid_credentials: '邮箱或密码错误。', rate_limited: '操作过于频繁，请稍后再试。', login_unavailable: '暂时无法登录，请稍后再试。',
				verification_unavailable: '验证码暂时无法发送，请稍后再试。', account_unavailable: '暂时无法设置密码，请稍后再试。', unauthorized: '请先登录。', forbidden: '没有执行此操作的权限。',
				slot_unavailable: '该时段刚被预约，请选择其他时间。', invalid_booking: '请检查预约资料与勾选项。', booking_unavailable: '预约暂时无法提交。',
				booking_not_found: '找不到这条预约，请刷新后重试。', booking_not_active: '该预约已更新，无需重复操作。', booking_changed: '预约状态刚刚改变，请刷新后重试。',
			}[code] || '操作失败，请稍后再试。');
			const closeOnBackdrop = (dialog: HTMLDialogElement | null) => dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
			closeOnBackdrop(authDialog);
			document.querySelectorAll<HTMLButtonElement>('[data-close-auth]').forEach((button) => button.addEventListener('click', () => authDialog?.close()));

			const openAuth = () => {
				const loginForm = authDialog?.querySelector<HTMLFormElement>('[data-login-form]');
				const passwordForm = authDialog?.querySelector<HTMLFormElement>('[data-password-form]');
				if (loginForm) loginForm.hidden = false;
				if (passwordForm) passwordForm.hidden = true;
				authDialog?.setAttribute('aria-labelledby', 'auth-dialog-title');
				authDialog?.querySelectorAll<HTMLElement>('[data-auth-message]').forEach((message) => { message.textContent = ''; });
				authDialog?.showModal();
				requestAnimationFrame(() => loginForm?.querySelector<HTMLInputElement>('input[name="email"]')?.focus());
			};
			const finishLogin = async () => {
				authDialog?.close();
				await syncSession();
				const next = new URLSearchParams(location.search).get('next');
				if (next?.startsWith('/ielts/') && !next.includes('//')) location.assign(next);
			};

			const renderMaterials = (materials: Array<Record<string, unknown>>, category = '') => {
				if (!materialList) return;
				materialList.replaceChildren();
				const visible = category ? materials.filter((item) => item.category === category) : materials;
				if (!visible.length) {
					const empty = document.createElement('p'); empty.textContent = category ? `暂时没有${category}资料。` : '资料正在整理中。'; materialList.append(empty); return;
				}
				for (const item of visible) {
					const row = document.createElement('article'); row.className = 'material-row';
					const copy = document.createElement('div');
					const title = document.createElement('strong'); title.textContent = String(item.title || '未命名资料');
					const meta = document.createElement('span'); meta.textContent = `${String(item.category || '')} · ${Math.max(1, Math.ceil(Number(item.size_bytes || 0) / 1048576))} MB`;
					const description = document.createElement('p'); description.textContent = String(item.description || item.file_name || '');
					copy.append(title, meta, description);
					const download = document.createElement('button'); download.type = 'button'; download.textContent = '下载';
					download.addEventListener('click', async () => {
						download.disabled = true;
						try { const result = await api<{ url: string }>(`/api/ielts/materials/${String(item.id)}`); window.location.assign(result.url); }
						catch (error) { description.textContent = messageFor(error instanceof Error ? error.message : ''); }
						finally { download.disabled = false; }
					});
					row.append(copy, download); materialList.append(row);
				}
			};
			let materialsCache: Array<Record<string, unknown>> = [];
			const loadMaterials = async () => {
				if (!session.authenticated) {
					materialsCache = [];
					if (materialState) materialState.textContent = '登录后查看';
					if (materialList) materialList.innerHTML = '<p>登录后可查看与下载学习资料。</p>';
					return;
				}
				try {
					const result = await api<{ materials: Array<Record<string, unknown>>; role: 'student' | 'admin' }>('/api/ielts/materials');
					materialsCache = result.materials;
					if (materialState) materialState.textContent = `${materialsCache.length} 份资料`;
					renderMaterials(materialsCache);
				} catch { if (materialState) materialState.textContent = '暂时无法读取'; }
			};
			const loadBookings = async () => {
				if (!bookingList) return;
				if (!session.authenticated) {
					bookingListState && (bookingListState.textContent = '登录后查看');
					bookingList.innerHTML = '<p>登录后可查看和取消预约。</p>';
					return;
				}
				try {
					const result = await api<{ bookings: Array<Record<string, unknown>> }>('/api/ielts/bookings?scope=mine');
					bookingList.replaceChildren();
					bookingListState && (bookingListState.textContent = `${result.bookings.length} 条记录`);
					if (!result.bookings.length) {
						const empty = document.createElement('p'); empty.textContent = '暂时没有预约记录。'; bookingList.append(empty); return;
					}
					const statusLabels: Record<string, string> = { pending: '待确认', confirmed: '已确认', cancelled: '已取消', declined: '未接受' };
					for (const item of result.bookings) {
						const row = document.createElement('article'); row.className = 'booking-row';
						const copy = document.createElement('div');
						const title = document.createElement('strong'); title.textContent = `${String(item.lesson_date || '')} · ${String(item.lesson_time || '')}`;
						const status = String(item.status || 'pending');
						const meta = document.createElement('span'); meta.textContent = `${String(item.lesson_subject || '')} · ${statusLabels[status] || status}`;
						copy.append(title, meta); row.append(copy);
						if (status === 'pending' || status === 'confirmed') {
							const cancel = document.createElement('button'); cancel.type = 'button'; cancel.textContent = '取消预约';
							cancel.addEventListener('click', async () => {
								if (cancel.dataset.confirm !== 'true') {
									cancel.dataset.confirm = 'true'; cancel.textContent = '确认取消'; cancel.classList.add('confirm');
									setTimeout(() => { if (cancel.isConnected) { delete cancel.dataset.confirm; cancel.textContent = '取消预约'; cancel.classList.remove('confirm'); } }, 5000);
									return;
								}
								cancel.disabled = true;
								try {
									await api('/api/ielts/bookings', { method: 'PATCH', body: JSON.stringify({ id: item.id, action: 'cancel' }) });
									await Promise.all([loadBookings(), loadAvailability()]);
								} catch (error) {
									cancel.disabled = false;
									cancel.textContent = messageFor(error instanceof Error ? error.message : '');
								}
							});
							row.append(cancel);
						}
						bookingList.append(row);
					}
				} catch { bookingListState && (bookingListState.textContent = '暂时无法读取'); }
			};
			const syncSession = async () => {
				try { session = await api<typeof session>('/api/ielts/auth/me'); } catch { session = { authenticated: false }; }
				if (accountEmail) accountEmail.textContent = session.email || '尚未登录';
				if (accountLogin) accountLogin.hidden = session.authenticated;
				if (accountLogout) accountLogout.hidden = !session.authenticated;
				if (accountButton) accountButton.title = session.email || '登录或注册';
				if (managementLink) managementLink.hidden = session.role !== 'admin';
				await Promise.all([loadMaterials(), loadBookings(), loadAvailability()]);
			};

			accountButton?.addEventListener('click', () => {
				if (!accountPanel) return;
				accountPanel.hidden = !accountPanel.hidden;
				accountButton.setAttribute('aria-expanded', String(!accountPanel.hidden));
			});
			accountLogin?.addEventListener('click', () => { if (accountPanel) accountPanel.hidden = true; accountButton?.setAttribute('aria-expanded', 'false'); openAuth(); });
			accountLogout?.addEventListener('click', async () => {
				accountLogout.disabled = true;
				await api('/api/ielts/auth/logout', { method: 'POST', body: '{}' }).catch(() => undefined);
				session = { authenticated: false };
				if (accountPanel) accountPanel.hidden = true;
				accountButton?.setAttribute('aria-expanded', 'false');
				await syncSession();
				accountLogout.disabled = false;
			});
			document.addEventListener('click', (event) => {
				if (accountPanel && !accountPanel.hidden && !accountMenu?.contains(event.target as Node)) {
					accountPanel.hidden = true;
					accountButton?.setAttribute('aria-expanded', 'false');
				}
			});

			authDialog?.querySelector<HTMLFormElement>('[data-login-form]')?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const form = event.currentTarget as HTMLFormElement;
				const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
				const message = form.querySelector<HTMLElement>('[data-auth-message]');
				const values = new FormData(form);
				if (submit) submit.disabled = true;
				if (message) message.textContent = '正在登录…';
				try {
					await api('/api/ielts/auth/login', { method: 'POST', body: JSON.stringify({ email: values.get('email'), password: values.get('password') }) });
					await finishLogin();
				} catch (error) { if (message) message.textContent = messageFor(error instanceof Error ? error.message : ''); }
				finally { if (submit) submit.disabled = false; }
			});

			authDialog?.querySelector<HTMLButtonElement>('[data-open-password-setup]')?.addEventListener('click', () => {
				const loginForm = authDialog?.querySelector<HTMLFormElement>('[data-login-form]');
				const passwordForm = authDialog?.querySelector<HTMLFormElement>('[data-password-form]');
				if (loginForm) loginForm.hidden = true;
				if (passwordForm) passwordForm.hidden = false;
				authDialog?.setAttribute('aria-labelledby', 'auth-reset-title');
				requestAnimationFrame(() => passwordForm?.querySelector<HTMLInputElement>('input[name="email"]')?.focus());
			});
			authDialog?.querySelector<HTMLButtonElement>('[data-back-login]')?.addEventListener('click', openAuth);

			authDialog?.querySelector<HTMLFormElement>('[data-password-form]')?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const form = event.currentTarget as HTMLFormElement;
				const codePane = form.querySelector<HTMLElement>('[data-password-code]');
				const submit = form.querySelector<HTMLButtonElement>('[data-password-submit]');
				const message = form.querySelector<HTMLElement>('[data-auth-message]');
				const values = new FormData(form);
				const email = String(values.get('email') || '').trim().toLowerCase();
				if (submit) submit.disabled = true;
				try {
					if (codePane?.hidden) {
						if (message) message.textContent = '正在发送验证码…';
						await api('/api/ielts/auth/request-code', { method: 'POST', body: JSON.stringify({ email }) });
						codePane.hidden = false;
						const emailLabel = form.querySelector<HTMLElement>('[data-auth-email]');
						if (emailLabel) emailLabel.textContent = `验证码已发送至 ${email}`;
						if (submit) submit.textContent = '验证并设置密码';
						if (message) message.textContent = '六位验证码 15 分钟内有效。';
						form.querySelector<HTMLInputElement>('input[name="code"]')?.focus();
					} else {
						const password = String(values.get('password') || '');
						if (password !== String(values.get('confirmPassword') || '')) throw new Error('password_mismatch');
						if (message) message.textContent = '正在验证并设置密码…';
						await api('/api/ielts/auth/verify-code', { method: 'POST', body: JSON.stringify({ email, code: values.get('code'), password }) });
						await finishLogin();
					}
				} catch (error) { if (message) message.textContent = messageFor(error instanceof Error ? error.message : ''); }
				finally { if (submit) submit.disabled = false; }
			});

			page?.addEventListener('click', (event) => {
				const target = event.target as Element;
				if (target.closest('[data-open-booking]') && !session.authenticated) {
					event.preventDefault(); event.stopImmediatePropagation(); openAuth(); return;
				}
				const categoryButton = target.closest<HTMLButtonElement>('[data-material-category]');
				if (categoryButton) {
					if (!session.authenticated) openAuth();
					else renderMaterials(materialsCache, categoryButton.dataset.materialCategory || '');
				}
			}, true);

			bookingForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!session.authenticated) { openAuth(); return; }
				const form = event.currentTarget as HTMLFormElement;
				const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
				const message = form.querySelector<HTMLElement>('[data-booking-message]');
				const values = new FormData(form);
				const date = page?.querySelector<HTMLButtonElement>('[data-calendar-days] button.selected')?.dataset.date || '';
				const time = page?.querySelector<HTMLButtonElement>('[data-time].selected')?.dataset.time || '';
				submit && (submit.disabled = true);
				if (message) message.textContent = '正在提交预约…';
				try {
					await loadAvailability();
					if (time !== '其他时间' && unavailable.get(date)?.has(time)) throw new Error('slot_unavailable');
					const result = await api<{ emailSent: boolean }>('/api/ielts/bookings', { method: 'POST', body: JSON.stringify({
						name: values.get('name'), contact: values.get('contact'), notes: values.get('note'), subject: values.get('subject'), date, time, consent: values.get('consent') === 'on',
					}) });
					if (message) message.textContent = result.emailSent ? '预约已提交，确认邮件已发送。' : '预约已提交；邮件稍有延迟，我会另行确认。';
					form.reset();
					await Promise.all([loadAvailability(), loadBookings()]);
				} catch (error) { if (message) message.textContent = messageFor(error instanceof Error ? error.message : ''); }
				finally {
					if (submit) submit.disabled = !(page?.querySelector('[data-calendar-days] button.selected') && page?.querySelector('[data-time].selected'));
				}
			});

			const loadAvailability = async () => {
				const title = page?.querySelector('[data-calendar-title]')?.textContent || '';
				const match = title.match(/(\d{4})\s*年\s*(\d{1,2})\s*月/);
				if (!match) return;
				const month = `${match[1]}-${match[2].padStart(2, '0')}`;
				try {
					const result = await api<{ unavailable: Array<{ lesson_date: string; lesson_time: string }> }>(`/api/ielts/availability?month=${month}&fresh=${Date.now()}`);
					unavailable = new Map();
					for (const item of result.unavailable) {
						const set = unavailable.get(item.lesson_date) || new Set<string>(); set.add(item.lesson_time); unavailable.set(item.lesson_date, set);
					}
					syncTimeAvailability();
				} catch { unavailable = new Map(); syncTimeAvailability(); }
			};
			const syncTimeAvailability = () => {
				const date = page?.querySelector<HTMLButtonElement>('[data-calendar-days] button.selected')?.dataset.date || '';
				const blocked = unavailable.get(date) || new Set<string>();
				for (const button of page?.querySelectorAll<HTMLButtonElement>('[data-time]') || []) {
					const time = button.dataset.time || '';
					const wasSelected = button.classList.contains('selected');
					button.disabled = blocked.has(time);
					button.textContent = button.disabled ? `${time}（已被预约）` : time;
					button.setAttribute('aria-label', button.disabled ? `${time}，已被预约` : time);
					if (button.disabled && wasSelected) {
						button.classList.remove('selected');
						button.setAttribute('aria-pressed', 'false');
						const submit = page?.querySelector<HTMLButtonElement>('[data-open-booking]');
						if (submit) submit.disabled = true;
						const status = page?.querySelector<HTMLElement>('[data-booking-status]');
						if (status) status.textContent = '该时段已被预约，请选择其他时间。';
						const selection = page?.querySelector<HTMLElement>('[data-booking-selection]');
						if (selection) selection.textContent = '请选择可预约的时间段。';
					}
				}
			};
			page?.addEventListener('click', (event) => {
				const target = event.target as Element;
				if (target.closest('[data-calendar-prev], [data-calendar-next]')) queueMicrotask(loadAvailability);
				if (target.closest('[data-calendar-days] button')) queueMicrotask(syncTimeAvailability);
			});
			window.addEventListener('focus', () => { void loadAvailability(); });
			document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') void loadAvailability(); });

			void syncSession().then(() => {
				const params = new URLSearchParams(location.search);
				if (params.get('login') === '1' && !session.authenticated) openAuth();
				else if (params.get('login') === '1' && session.authenticated) {
					const next = params.get('next');
					if (session.role === 'admin' && next?.startsWith('/ielts/') && !next.includes('//')) location.assign(next);
				}
			});
		</script>
	</IeltsLayout>

<style>
	.ielts-app { width: min(1680px, calc(100% - 40px)); min-height: calc(100dvh - 40px); margin: 20px auto; display: grid; grid-template-columns: 244px minmax(0, 1fr); overflow: hidden; border: 1px solid var(--ielts-line); border-radius: 22px; background: var(--ielts-panel); box-shadow: var(--ielts-shadow); }
	.side-panel { position: sticky; top: 0; height: calc(100dvh - 40px); display: flex; flex-direction: column; padding: 32px 20px 24px; border-right: 1px solid var(--ielts-line); background: color-mix(in srgb, var(--ielts-card) 92%, transparent); }
	.studio-brand { display: grid; justify-items: center; gap: 5px; color: var(--ielts-ink); font-size: 11px; font-weight: 600; letter-spacing: .25em; }
