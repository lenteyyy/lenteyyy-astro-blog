---
import IeltsIcon from '../../components/ielts/IeltsIcon.astro';
import IeltsLayout from '../../layouts/IeltsLayout.astro';
import { getAuthContext } from '../../lib/ielts/auth';

export const prerender = false;

const auth = await getAuthContext(Astro.cookies);
if (!auth) return Astro.redirect('/ielts?login=1&next=%2Fielts%2Fmanagement');
if (auth.role !== 'admin') return Astro.redirect('/ielts?forbidden=1');
---
<IeltsLayout title="IELTS 管理后台" description="Lenteyyy IELTS 学习资料管理。">
	<main class="management" data-management-page>
		<header>
			<a class="brand" href="/ielts"><img src="/lenteyyy-logo.png" alt="Lenteyyy" width="512" height="512" /><span>IELTS MANAGEMENT</span></a>
			<nav><a href="/ielts">返回学习中心</a><a href="/">返回主站</a><button type="button" data-logout>退出</button></nav>
		</header>

		<section class="panel upload-panel">
			<div class="section-head"><div><span>ADMIN ONLY</span><h1>上传学习资料</h1></div><div class="theme"><button type="button" data-theme-choice="light">浅色</button><button type="button" data-theme-choice="dark">深色</button></div></div>
			<form data-upload-form>
				<label>资料标题<input name="title" maxlength="120" required /></label>
				<label>分类<select name="category" required><option>听力</option><option>阅读</option><option>写作</option><option>口语</option><option>词汇</option><option>语法</option><option>备考</option></select></label>
				<label class="wide">简短说明<textarea name="description" rows="3" maxlength="300"></textarea></label>
				<label class="wide file-field">文件<input type="file" name="file" accept=".pdf,.docx,.pptx,.mp3,.m4a,.mp4,.jpg,.jpeg,.png,.webp" required /></label>
				<p class="note wide">单个文件上限 100 MB；文件存入私有空间，仅通过短时签名链接访问。</p>
				<p class="message wide" data-upload-message aria-live="polite"></p>
				<button class="submit wide" type="submit">上传并发布<IeltsIcon name="arrow" size={18} /></button>
			</form>
		</section>

		<section class="panel list-panel">
			<div class="section-head"><div><span>LIBRARY</span><h2>已发布资料</h2></div><strong data-material-count>读取中</strong></div>
			<div class="materials" data-material-list></div>
		</section>

		<section class="panel bookings-panel">
			<div class="section-head"><div><span>BOOKINGS</span><h2>课程预约</h2></div><strong data-booking-count>读取中</strong></div>
			<div class="bookings" data-booking-list></div>
			<details class="cancelled-bookings" data-cancelled-section hidden>
				<summary>已取消预约 <span data-cancelled-count></span></summary>
				<div class="bookings" data-cancelled-list></div>
			</details>
		</section>
	</main>

	<script>
		import { createClient } from '@supabase/supabase-js';

		const page = document.querySelector<HTMLElement>('[data-management-page]');
		const list = page?.querySelector<HTMLElement>('[data-material-list]');
		const count = page?.querySelector<HTMLElement>('[data-material-count]');
		const bookingList = page?.querySelector<HTMLElement>('[data-booking-list]');
		const bookingCount = page?.querySelector<HTMLElement>('[data-booking-count]');
		const cancelledSection = page?.querySelector<HTMLDetailsElement>('[data-cancelled-section]');
		const cancelledList = page?.querySelector<HTMLElement>('[data-cancelled-list]');
		const cancelledCount = page?.querySelector<HTMLElement>('[data-cancelled-count]');
		const api = async <T,>(path: string, init?: RequestInit): Promise<T> => {
			const response = await fetch(path, { credentials: 'same-origin', cache: 'no-store', ...init, headers: { 'content-type': 'application/json', ...(init?.headers || {}) } });
			const body = await response.json().catch(() => ({}));
			if (!response.ok) throw new Error(String(body.error || `http_${response.status}`));
			return body as T;
		};
		const loadMaterials = async () => {
			try {
				const result = await api<{ materials: Array<Record<string, unknown>> }>('/api/ielts/materials');
				if (count) count.textContent = `${result.materials.length} 份`;
				list?.replaceChildren();
				if (!result.materials.length && list) { const empty = document.createElement('p'); empty.textContent = '尚未上传资料。'; list.append(empty); }
				for (const item of result.materials) {
					const row = document.createElement('article');
					const copy = document.createElement('div');
					const title = document.createElement('strong'); title.textContent = String(item.title || '未命名资料');
					const meta = document.createElement('span'); meta.textContent = `${String(item.category || '')} · ${String(item.file_name || '')}`;
					copy.append(title, meta); row.append(copy); list?.append(row);
				}
			} catch { if (count) count.textContent = '读取失败'; }
		};
		const loadBookings = async () => {
			try {
				const result = await api<{ bookings: Array<Record<string, unknown>> }>('/api/ielts/bookings');
				const active = result.bookings.filter((item) => item.status !== 'cancelled' && item.status !== 'declined');
				const cancelled = result.bookings.filter((item) => item.status === 'cancelled' || item.status === 'declined');
				if (bookingCount) bookingCount.textContent = `${active.length} 条待处理`;
				bookingList?.replaceChildren();
				cancelledList?.replaceChildren();
				if (!active.length && bookingList) { const empty = document.createElement('p'); empty.textContent = '暂无待处理预约。'; bookingList.append(empty); }
				const statusLabels: Record<string, string> = { pending: '待确认', confirmed: '已确认', cancelled: '已取消', declined: '未接受' };
				const renderBooking = (item: Record<string, unknown>, target: HTMLElement | null | undefined) => {
					const row = document.createElement('article');
					const copy = document.createElement('div');
					const title = document.createElement('strong'); title.textContent = `${String(item.name || '')} · ${String(item.lesson_subject || '')}`;
					const status = String(item.status || 'pending');
					const time = item.lesson_time === '其他时间' && item.lesson_time_note ? `其他时间：${String(item.lesson_time_note)}` : String(item.lesson_time || '');
					const meta = document.createElement('span'); meta.textContent = `${String(item.lesson_date || '')} · ${time} · ${statusLabels[status] || status}`;
					const contact = document.createElement('p'); contact.textContent = `${String(item.email || '')}${item.contact ? ` · ${String(item.contact)}` : ''}`;
					copy.append(title, meta, contact); row.append(copy);
					if (status === 'pending' || status === 'confirmed') {
						const actions = document.createElement('div'); actions.className = 'booking-actions';
						if (status === 'pending') {
							const confirm = document.createElement('button'); confirm.type = 'button'; confirm.textContent = '确认预约'; confirm.className = 'confirm-booking';
							confirm.addEventListener('click', async () => {
								confirm.disabled = true;
								try { await api('/api/ielts/bookings', { method: 'PATCH', body: JSON.stringify({ id: item.id, action: 'confirm' }) }); await loadBookings(); }
								catch { confirm.disabled = false; confirm.textContent = '确认失败'; }
							});
							actions.append(confirm);
						}
						const cancel = document.createElement('button'); cancel.type = 'button'; cancel.textContent = '取消预约';
						cancel.addEventListener('click', async () => {
							if (cancel.dataset.confirm !== 'true') {
								cancel.dataset.confirm = 'true'; cancel.textContent = '确认取消'; cancel.classList.add('confirm');
								setTimeout(() => { if (cancel.isConnected) { delete cancel.dataset.confirm; cancel.textContent = '取消预约'; cancel.classList.remove('confirm'); } }, 5000);
								return;
							}
							cancel.disabled = true;
							try { await api('/api/ielts/bookings', { method: 'PATCH', body: JSON.stringify({ id: item.id, action: 'cancel' }) }); await loadBookings(); }
							catch { cancel.disabled = false; cancel.textContent = '取消失败'; }
						});
						actions.append(cancel); row.append(actions);
					}
					target?.append(row);
				};
				active.forEach((item) => renderBooking(item, bookingList));
				cancelled.forEach((item) => renderBooking(item, cancelledList));
				if (cancelledSection) cancelledSection.hidden = cancelled.length === 0;
				if (cancelledCount) cancelledCount.textContent = `${cancelled.length} 条`;
			} catch { if (bookingCount) bookingCount.textContent = '读取失败'; }
		};

		page?.querySelector<HTMLFormElement>('[data-upload-form]')?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const form = event.currentTarget as HTMLFormElement;
			const values = new FormData(form);
			const file = values.get('file');
			const message = form.querySelector<HTMLElement>('[data-upload-message]');
			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (!(file instanceof File)) return;
			if (file.size > 104857600) { if (message) message.textContent = '单个文件不能超过 100 MB。'; return; }
			if (submit) submit.disabled = true;
			if (message) message.textContent = '正在安全上传…';
			try {
				const signed = await api<{ path: string; token: string }>('/api/ielts/materials/upload-url', { method: 'POST', body: JSON.stringify({ fileName: file.name, mimeType: file.type, sizeBytes: file.size }) });
				const url = import.meta.env.PUBLIC_SUPABASE_URL;
				const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
				if (!url || !key) throw new Error('upload_unavailable');
				const uploaded = await createClient(url, key).storage.from('ielts-materials').uploadToSignedUrl(signed.path, signed.token, file, { contentType: file.type, upsert: false });
				if (uploaded.error) throw new Error('upload_unavailable');
				await api('/api/ielts/materials', { method: 'POST', body: JSON.stringify({ title: values.get('title'), category: values.get('category'), description: values.get('description'), storagePath: signed.path, fileName: file.name, mimeType: file.type, sizeBytes: file.size }) });
				if (message) message.textContent = '资料已上传并发布。';
				form.reset(); await loadMaterials();
			} catch { if (message) message.textContent = '上传失败，请检查文件格式后重试。'; }
			finally { if (submit) submit.disabled = false; }
		});

		page?.querySelector<HTMLButtonElement>('[data-logout]')?.addEventListener('click', async () => {
			await api('/api/ielts/auth/logout', { method: 'POST', body: '{}' }).catch(() => undefined);
			location.assign('/ielts');
		});
		const themeButtons = [...(page?.querySelectorAll<HTMLButtonElement>('[data-theme-choice]') || [])];
		const syncTheme = (theme: 'light' | 'dark') => {
			document.documentElement.dataset.ieltsTheme = theme;
			try { localStorage.setItem('ielts-theme', theme); } catch {}
			themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme)));
		};
		themeButtons.forEach((button) => button.addEventListener('click', () => syncTheme(button.dataset.themeChoice === 'dark' ? 'dark' : 'light')));
		themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === document.documentElement.dataset.ieltsTheme)));
		void Promise.all([loadMaterials(), loadBookings()]);
	</script>
</IeltsLayout>

<style>
	.management { width: min(980px, calc(100% - 36px)); margin: 28px auto; display: grid; gap: 18px; }
	header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 16px 20px; border: 1px solid var(--ielts-line); border-radius: 14px; background: var(--ielts-card); }
	.brand { display: flex; align-items: center; gap: 12px; color: var(--ielts-ink); font-size: 11px; font-weight: 700; letter-spacing: .18em; }
	.brand img { width: 68px; height: 44px; object-fit: contain; background: #fff; }
	nav { display: flex; align-items: center; gap: 9px; }
	nav a, nav button { min-height: 38px; padding: 0 13px; border: 1px solid var(--ielts-line); border-radius: 8px; background: transparent; color: var(--ielts-text); cursor: pointer; font-size: 12px; }
	.panel { padding: 28px; border: 1px solid var(--ielts-line); border-radius: 14px; background: var(--ielts-card); box-shadow: var(--ielts-shadow); }
	.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
	.section-head span { color: var(--ielts-muted); font-size: 10px; letter-spacing: .15em; }
	.section-head h1, .section-head h2 { margin: 5px 0 0; color: var(--ielts-ink); font-size: 28px; }
	.section-head strong { color: var(--ielts-muted); font-size: 12px; }
	.theme { display: flex; gap: 5px; padding: 4px; border: 1px solid var(--ielts-line); border-radius: 999px; }
	.theme button { min-height: 30px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: var(--ielts-muted); cursor: pointer; font-size: 11px; }
	.theme button[aria-pressed='true'] { background: var(--ielts-accent-soft); color: var(--ielts-ink); }
	form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	label { display: grid; gap: 7px; color: var(--ielts-text); font-size: 13px; font-weight: 500; }
	input, select, textarea { width: 100%; padding: 12px; border: 1px solid var(--ielts-line); border-radius: 8px; background: var(--ielts-panel); color: var(--ielts-ink); resize: vertical; }
	.wide { grid-column: 1 / -1; }
	.file-field input { padding: 10px; }
	.note, .message { margin: 0; color: var(--ielts-muted); font-size: 11px; line-height: 1.6; }
	.message { min-height: 18px; color: var(--ielts-accent); }
	.submit { min-height: 48px; display: flex; align-items: center; justify-content: center; gap: 9px; border: 0; border-radius: 8px; background: var(--ielts-ink); color: var(--ielts-card); cursor: pointer; font-weight: 600; }
	.submit:disabled { opacity: .55; cursor: wait; }
	.materials { display: grid; gap: 8px; }
	.materials article { padding: 13px 14px; border: 1px solid var(--ielts-line); border-radius: 8px; }
	.materials article div { display: grid; gap: 4px; }
	.materials strong { color: var(--ielts-ink); font-size: 13px; }
	.materials span, .materials p { margin: 0; color: var(--ielts-muted); font-size: 11px; }
	.bookings { display: grid; gap: 8px; }
	.bookings article { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 13px 14px; border: 1px solid var(--ielts-line); border-radius: 8px; }
	.bookings article div { min-width: 0; display: grid; gap: 4px; }
	.bookings strong { color: var(--ielts-ink); font-size: 13px; }
	.bookings span, .bookings p { margin: 0; overflow-wrap: anywhere; color: var(--ielts-muted); font-size: 11px; }
	.bookings button { min-height: 36px; padding: 0 13px; border: 1px solid var(--ielts-line); border-radius: 7px; background: transparent; color: var(--ielts-text); cursor: pointer; }
	.bookings .booking-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
	.bookings button.confirm-booking { border-color: var(--ielts-accent); background: var(--ielts-accent-soft); color: var(--ielts-ink); }
	.bookings button.confirm { border-color: #b55252; background: #b55252; color: #fff; }
	.cancelled-bookings { margin-top: 16px; border-top: 1px solid var(--ielts-line); }
	.cancelled-bookings summary { padding: 16px 2px 6px; color: var(--ielts-muted); cursor: pointer; font-size: 12px; font-weight: 600; }
	.cancelled-bookings summary span { margin-left: 6px; font-weight: 400; }
	.cancelled-bookings .bookings { margin-top: 8px; opacity: .72; }
	@media (max-width: 700px) {
		.management { width: min(100% - 20px, 980px); margin: 10px auto; }
		header { align-items: flex-start; }
		nav { flex-wrap: wrap; justify-content: flex-end; }
		.panel { padding: 20px; }
		form { grid-template-columns: 1fr; }
		.wide { grid-column: auto; }
	}
</style>
