---
import MockExam from '../../../components/ielts/MockExam.astro';
import {getAuthContext} from '../../../lib/ielts/auth';
import {paperPayload} from '../../../lib/ielts/mock/papers';
import {readWorkflow,workflowUrl} from '../../../lib/ielts/mock/run-policy';
export const prerender=false;
const match=/^(c20-)?test-([1234])$/.exec(Astro.params.paper||'');
if(!match)return new Response('Not found',{status:404,headers:{'Cache-Control':'no-store'}});
const workflow=readWorkflow(Astro.url.searchParams);
if(!workflow)return new Response('Invalid exam selection',{status:400,headers:{'Cache-Control':'no-store'}});
const {subject,mode,subjects}=workflow;
const book=match[1]?20:21;
const test=Number(match[2]);
const demo=import.meta.env.DEV&&Astro.url.searchParams.get('demo')==='1';
const auth=demo?undefined:await getAuthContext(Astro.cookies);
if(!auth&&!demo){
 const redirect=new URL('/ielts',Astro.url);
 redirect.searchParams.set('login','1');
 redirect.searchParams.set('next',workflowUrl(book,test,mode,subjects,subject));
 return Astro.redirect(redirect.pathname+redirect.search);
}
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
const payload=paperPayload(test,subject,auth?.user.id||'demo',book,mode,subjects);
---
<MockExam {...payload}/>
