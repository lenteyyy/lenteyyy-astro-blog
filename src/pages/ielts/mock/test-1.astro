---
import IeltsLayout from '../../../layouts/IeltsLayout.astro';
import { getAuthContext } from '../../../lib/ielts/auth';
import test from '../../../lib/ielts/mock/test1-content.json';
import { questionSets } from '../../../lib/ielts/mock/test1-questions';

export const prerender = false;

type Subject = 'listening' | 'reading' | 'writing';
const requested = Astro.url.searchParams.get('subject')?.toLowerCase();
const subject: Subject = requested === 'reading' || requested === 'writing' ? requested : 'listening';
const demo = import.meta.env.DEV && Astro.url.searchParams.get('demo') === '1';
if (!demo && !Astro.cookies.has('ielts_access') && !Astro.cookies.has('ielts_refresh')) return Astro.redirect(`/ielts?login=1&next=${encodeURIComponent(`/ielts/mock/test-1?subject=${subject}`)}`);
const auth = demo ? undefined : await getAuthContext(Astro.cookies);
if (!auth && !demo) return Astro.redirect(`/ielts?login=1&next=${encodeURIComponent(`/ielts/mock/test-1?subject=${subject}`)}`);

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const labels: Record<Subject, string> = { listening: 'Listening', reading: 'Reading', writing: 'Writing' };
const sections = test.sections[subject];
const answerKey = subject === 'writing' ? [] : test.answerKeys[subject];
const payload = JSON.stringify({ subject, sections, answerKey, blocks: subject === 'writing' ? [] : questionSets[subject], accountId: auth?.user.id || 'demo' }).replace(/</g, '\\u003c');
---
<IeltsLayout title={`剑雅21 Test 1 · ${labels[subject]}`} description="雅思机考练习页面。" telemetry={false}>
  <main class="exam" data-exam>
    <header class="brandbar">
      <nav class="subjects" aria-label="选择科目">
        {(['listening', 'reading', 'writing'] as const).map((item) => <a class:list={[{ active: subject === item }]} href={`/ielts/mock/test-1?subject=${item}`}>{labels[item]}</a>)}
      </nav>
    </header>
    <div class="statusbar"><span>{labels[subject]} · Test 1</span><strong data-clock>{subject === 'listening' ? '35:00' : '60:00'}</strong><div class="toolbar"><button type="button" data-clear>清除本机答案</button><button type="button" data-help>Help</button></div></div>
    <div class:list={['workspace', { 'listening-workspace': subject === 'listening', 'reading-workspace': subject === 'reading' }]}>
      <section class="pane question-pane" aria-label="题目">
        <div class="pane-head"><h1 data-section-title></h1><span data-section-range></span></div>
        <div class="question-scroll" data-question-scroll tabindex="0">
          {subject === 'writing' && <p class="instructions" data-instructions></p>}
          {subject === 'listening' && <div class="audio-wrap" data-audio-wrap hidden><audio controls preload="none" data-audio></audio></div>}
          <div data-passage></div>
          {subject === 'listening' && <div data-question-content></div>}
          {subject === 'writing' && <div data-question-images></div>}
        </div>
      </section>
      {subject === 'reading' && <div class="divider" data-divider role="separator" aria-label="调整原文与题目宽度" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-controls="reading-answers" tabindex="0"><span aria-hidden="true"></span></div>}
      {subject !== 'listening' && <section class="pane answer-pane" aria-label={subject === 'reading' ? '阅读题目' : '答题区'}>
        <div class="pane-head"><h2>{subject === 'writing' ? 'Your answer' : 'Questions'}</h2><span data-answer-heading></span></div>
        {subject === 'reading' && <div class="answer-scroll" id="reading-answers" data-question-content></div>}
        {subject === 'writing' && <div class="answer-scroll" data-answer-scroll></div>}
        {subject === 'writing' && <p class="word-count"><span data-word-count>0 words</span><span data-save-state>仅保存在本机浏览器</span></p>}
      </section>}
    </div>
    {subject === 'reading' && <div class="highlight-tools" data-highlight-tools role="group" aria-label="原文高亮" hidden><button type="button" data-highlight-add>高亮</button><button type="button" data-highlight-remove>取消高亮</button></div>}
    <nav class="test-nav" aria-label="试卷导航"><label><input type="checkbox" data-review /> Mark for review</label><div class="section-tabs" data-section-tabs></div><div class="nav-actions"><button type="button" data-prev aria-label="上一部分">‹</button><button type="button" data-next aria-label="下一部分">›</button><button type="button" class="submit" data-submit>Submit</button></div></nav>
  </main>

  <div class="overlay" data-start><section class="modal" role="dialog" aria-modal="true" aria-labelledby="start-title"><div class="modal-head"><h2 id="start-title">剑雅21 Test 1 · {labels[subject]}</h2></div><div class="modal-body"><p>按机考界面练习；答案和计时只保存在当前浏览器。关闭页面后重新打开，可继续本次练习。</p>{subject === 'reading' && <p>原文高亮和分栏宽度也保存在本机，清除本机答案时一并删除。</p>}<p>{subject === 'listening' ? '35 分钟练习计时，含四段录音与检查时间。' : '60 分钟练习计时。'}提交后，听力和阅读会显示对题数；写作不自动估分。</p><label><input type="checkbox" data-ready /> 我已阅读并准备开始</label></div><div class="modal-actions"><button type="button" data-resume disabled>继续上次练习</button><button type="button" class="primary" data-start-button disabled>开始</button></div></section></div>
  <dialog class="result-dialog" data-dialog><div data-dialog-body></div><form method="dialog"><button type="button" data-reset>重新开始</button><button>关闭</button></form></dialog>
  <script is:inline type="application/json" id="exam-payload" set:html={payload} />

  <script>
    import { setupReadingTools } from '../../../lib/ielts/mock/reading-tools';
    import { normalizeHighlights, type HighlightRange } from '../../../lib/ielts/mock/reading-state';
    import type { Choice, QuestionBlock } from '../../../lib/ielts/mock/test1-questions';
    type Section = { label: string; first: number; last: number; title: string; instructions: string; paragraphs: string[]; questionImages: string[]; audioUrl: string };
    type Payload = { subject: 'listening' | 'reading' | 'writing'; sections: Section[]; answerKey: string[]; blocks: QuestionBlock[][]; accountId: string };
    type Saved = { version: number; active: number; answers: Record<string, string>; review: boolean[]; started: boolean; finished: boolean; deadline: number; split: number; highlights: Record<string, HighlightRange[]> };
    const root = document.querySelector<HTMLElement>('[data-exam]');
    const parsed = document.querySelector<HTMLElement>('#exam-payload');
    if (root && parsed) {
      const data = JSON.parse(parsed.textContent || '{}') as Payload;
      const key = `lenteyyy-mock-c21-t1-${data.subject}-${data.accountId}`;
      const duration = data.subject === 'listening' ? 35 * 60 : 60 * 60;
      const defaults = (): Saved => ({ version: 1, active: 0, answers: {}, review: data.sections.map(() => false), started: false, finished: false, deadline: 0, split: 50, highlights: {} });
      const load = (): Saved => {
        try {
          const value = JSON.parse(localStorage.getItem(key) || 'null'); const clean = defaults();
          if (value?.version !== 1 || !Array.isArray(value.review)) return clean;
          clean.active = Number.isInteger(value.active) && value.active >= 0 && value.active < data.sections.length ? value.active : 0;
          clean.review = data.sections.map((_, index) => value.review[index] === true);
          clean.deadline = typeof value.deadline === 'number' && Number.isFinite(value.deadline) && value.deadline > 0 ? value.deadline : 0;
          clean.started = value.started === true && clean.deadline > 0; clean.finished = value.finished === true && clean.started;
          if (value.answers && typeof value.answers === 'object') for (const [number, answer] of Object.entries(value.answers)) {
            if (/^(?:[1-9]|[1-3]\d|40)$/.test(number) && typeof answer === 'string') clean.answers[number] = answer.slice(0, data.subject === 'writing' ? 100000 : 1000);
          }
          clean.split = typeof value.split === 'number' && Number.isFinite(value.split) ? Math.max(0, Math.min(100, value.split)) : 50;
          if (value.highlights && typeof value.highlights === 'object') for (let index = 0; index < data.sections.length; index++) clean.highlights[String(index)] = normalizeHighlights(value.highlights[String(index)], 200000);
          return clean;
        } catch { return defaults(); }
      };
      let state = load();
      const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector);
      const overlay = document.querySelector<HTMLElement>('[data-start]');
      const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');
      const dialogBody = document.querySelector<HTMLElement>('[data-dialog-body]');
      const save = () => { try { localStorage.setItem(key, JSON.stringify(state)); } catch { const status = $<HTMLElement>('[data-save-state]'); if (status) status.textContent = '本机存储不可用，离开页面会丢失答案'; } };
      const readingTools = data.subject === 'reading' ? setupReadingTools(root, {
        getSplit: () => state.split, setSplit: (value) => { state.split = value; save(); },
        getHighlights: () => state.highlights[String(state.active)] || [],
        setHighlights: (value) => { state.highlights[String(state.active)] = value; save(); },
      }) : undefined;
      const words = (value: string) => (value.match(/[\p{L}\p{N}]+(?:[’'-][\p{L}\p{N}]+)*/gu) || []).length;
      const formatTime = (seconds: number) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
      const showDialog = (message: string) => { if (dialogBody) dialogBody.textContent = message; dialog?.showModal(); };
      const updateClock = () => {
        const left = state.started ? Math.max(0, Math.ceil((state.deadline - Date.now()) / 1000)) : duration;
        const clock = $<HTMLElement>('[data-clock]'); if (clock) clock.textContent = formatTime(left);
        if (left === 0 && state.started && !state.finished) { state.finished = true; save(); render(); showDialog('时间已到。答案仍保存在当前浏览器。'); }
      };
      const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', value = '') => {
        const node = document.createElement(tag); node.className = className; node.textContent = value; return node;
      };
      const correct = (number: number) => data.answerKey[number - 1]?.replaceAll('|', ' / ') || '—';
      const answerControl = (number: number, options?: string[]) => {
        const wrap = element('label', 'inline-answer');
        wrap.append(element('strong', 'answer-number', String(number)));
        if (options) {
          const select = document.createElement('select'); select.setAttribute('aria-label', `Question ${number}`);
          const empty = document.createElement('option'); empty.value = ''; empty.textContent = '选择'; select.append(empty);
          for (const option of options) { const item = document.createElement('option'); item.value = option; item.textContent = option; select.append(item); }
          select.value = state.answers[String(number)] || ''; select.disabled = state.finished;
          select.addEventListener('change', () => { state.answers[String(number)] = select.value; save(); }); wrap.append(select);
        } else {
          const input = document.createElement('input'); input.type = 'text'; input.autocomplete = 'off'; input.spellcheck = false;
          input.setAttribute('aria-label', `Question ${number}`); input.value = state.answers[String(number)] || ''; input.disabled = state.finished;
          input.addEventListener('input', () => { state.answers[String(number)] = input.value; save(); }); wrap.append(input);
        }
        if (state.finished) wrap.append(element('small', 'correct-answer', `参考：${correct(number)}`));
        return wrap;
      };
      const fillText = (text: string) => {
        const fragment = document.createDocumentFragment();
        for (const part of text.split(/(\{\{\d+\}\})/g)) {
          const match = /^\{\{(\d+)\}\}$/.exec(part);
          if (match) {
            const number = Number(match[1]);
            fragment.append(answerControl(number, data.subject === 'reading' && number >= 31 && number <= 36 ? 'ABCDEFGHI'.split('') : undefined));
          } else if (part) fragment.append(document.createTextNode(part));
        }
        return fragment;
      };
      const appendText = (parent: HTMLElement, tag: 'p' | 'li', value: string, className = '') => {
        const node = element(tag, className); node.append(fillText(value)); parent.append(node); return node;
      };
      const optionBank = (options: Choice[], title = '') => {
        const box = element('div', 'option-bank'); if (title) box.append(element('h4', '', title));
        const definitions = options.some((option) => option.letter.length > 1);
        if (definitions) box.classList.add('definition-bank');
        const grid = element('div', definitions ? 'definition-grid' : 'option-grid');
        for (const option of options) { const row = element('div', 'option-bank-row'); row.append(element('strong', '', option.letter), element('span', '', option.text)); grid.append(row); }
        box.append(grid); return box;
      };
      const renderBlocks = () => {
        const target = $<HTMLElement>('[data-question-content]'); target?.replaceChildren(); if (!target) return;
        for (const block of data.blocks[state.active] || []) {
          if (block.type === 'heading') target.append(element('h3', 'question-heading', block.text));
          if (block.type === 'subheading') target.append(element('h4', 'question-subheading', block.text));
          if (block.type === 'instruction') target.append(element('p', 'question-instruction', block.text));
          if (block.type === 'paragraph') appendText(target, 'p', block.text, 'question-paragraph');
          if (block.type === 'table') {
            const wrap = element('div', 'table-wrap'); wrap.append(element('h4', 'table-title', block.title));
            const table = document.createElement('table'); const head = document.createElement('thead'); const headRow = document.createElement('tr');
            for (const label of block.columns) headRow.append(element('th', '', label)); head.append(headRow); table.append(head);
            const body = document.createElement('tbody');
            for (const row of block.rows) { const tr = document.createElement('tr'); for (const cell of row) { const td = element('td'); td.append(fillText(cell)); tr.append(td); } body.append(tr); }
            table.append(body); wrap.append(table); target.append(wrap);
          }
          if (block.type === 'notes') {
            const box = element('section', 'note-box'); box.append(element('h4', 'note-title', block.title));
            for (const group of block.groups) { if (group.heading) box.append(element('h5', 'note-heading', group.heading));
              for (const text of group.intro || []) appendText(box, 'p', text, 'note-intro');
              const list = element('ul', 'note-list'); for (const item of group.items) appendText(list, 'li', item); box.append(list);
            } target.append(box);
          }
          if (block.type === 'summary') {
            const box = element('section', 'summary-box'); box.append(element('h4', 'note-title', block.title));
            for (const text of block.paragraphs) appendText(box, 'p', text); target.append(box);
          }
          if (block.type === 'bank') target.append(optionBank(block.options, block.title));
          if (block.type === 'choice') {
            const group = element('fieldset', 'choice-question'); group.append(element('legend', '', `${block.number}  ${block.prompt}`));
            for (const option of block.options) { const label = element('label', 'choice-option'); const radio = document.createElement('input');
              radio.type = 'radio'; radio.name = `question-${block.number}`; radio.value = option.letter;
              radio.checked = state.answers[String(block.number)] === option.letter; radio.disabled = state.finished;
              radio.addEventListener('change', () => { state.answers[String(block.number)] = option.letter; save(); });
              label.append(radio, element('strong', '', option.letter), document.createTextNode(option.text)); group.append(label);
            }
            if (state.finished) group.append(element('small', 'correct-answer', `参考：${correct(block.number)}`)); target.append(group);
          }
          if (block.type === 'pair') {
            const group = element('fieldset', 'choice-question'); group.append(element('legend', '', `${block.numbers.join(' & ')}  ${block.prompt}`));
            for (const option of block.options) { const label = element('label', 'choice-option'); const checkbox = document.createElement('input');
              checkbox.type = 'checkbox'; checkbox.value = option.letter; checkbox.checked = block.numbers.some((number) => state.answers[String(number)] === option.letter); checkbox.disabled = state.finished;
              checkbox.addEventListener('change', () => { const chosen = block.numbers.map((number) => state.answers[String(number)]).filter(Boolean);
                if (checkbox.checked) { if (chosen.length >= 2) { checkbox.checked = false; return; } chosen.push(option.letter); }
                else { const index = chosen.indexOf(option.letter); if (index >= 0) chosen.splice(index, 1); }
                block.numbers.forEach((number, index) => { state.answers[String(number)] = chosen[index] || ''; }); save();
              }); label.append(checkbox, element('strong', '', option.letter), document.createTextNode(option.text)); group.append(label);
            }
            if (state.finished) group.append(element('small', 'correct-answer', `参考：${block.numbers.map(correct).join(' / ')}`)); target.append(group);
          }
          if (block.type === 'match') {
            target.append(optionBank(block.options, block.title === 'Resources' ? 'Opinions' : block.title === 'Duties' ? 'Abilities' : block.title || 'Options'));
            if (block.title === 'Resources') target.append(element('h4', 'question-subheading', 'Resources'));
            if (block.title === 'Duties') target.append(element('h4', 'question-subheading', 'Duties'));
            const rows = element('div', 'match-rows'); for (const row of block.rows) {
              const line = element('div', 'match-row'); line.append(element('strong', 'question-index', String(row.number)), element('span', '', row.text), answerControl(row.number, block.options.map((option) => option.letter))); rows.append(line);
            } target.append(rows);
          }
          if (block.type === 'statements') {
            const rows = element('div', 'statement-rows'); for (const row of block.rows) {
              const line = element('div', 'statement-row'); line.append(element('strong', 'question-index', String(row.number)), element('span', '', row.text), answerControl(row.number, block.options)); rows.append(line);
            } target.append(rows);
          }
        }
      };
      const render = () => {
        const section = data.sections[state.active]; if (!section) return;
        const title = $<HTMLElement>('[data-section-title]'); if (title) title.textContent = section.title;
        const range = $<HTMLElement>('[data-section-range]'); if (range) range.textContent = data.subject === 'writing' ? `Task ${state.active + 1}` : `Questions ${section.first}–${section.last}`;
        const instructions = $<HTMLElement>('[data-instructions]'); if (instructions) instructions.textContent = section.instructions;
        const passage = $<HTMLElement>('[data-passage]'); passage?.replaceChildren();
        if (data.subject === 'reading' && passage) {
          passage.append(element('p', 'passage-intro', `You should spend about 20 minutes on Questions ${section.first}–${section.last}, which are based on Reading Passage ${state.active + 1} below.`));
          passage.append(element('h2', 'passage-title', section.title));
        }
        for (const [index, text] of section.paragraphs.entries()) { const paragraph = element('p', data.subject === 'reading' && index === 0 && state.active === 0 ? 'passage-lede' : '', text); passage?.append(paragraph); }
        if (data.subject === 'reading' && state.active === 0 && passage) {
          passage.append(element('p', 'passage-footnote', '* philanthropic: seeking to promote the welfare of others, often by charitable funding'));
          passage.append(element('p', 'passage-footnote', '** Old Master: a highly respected artist of great skill who worked in Europe before about 1800'));
          passage.append(element('p', 'passage-footnote', '*** Impressionist: an artist with a style of painting that developed in France in the late 1800s'));
        }
        const images = $<HTMLElement>('[data-question-images]'); images?.replaceChildren();
        if (data.subject === 'writing') for (const url of section.questionImages) { const link = document.createElement('a'); link.href = url; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.setAttribute('aria-label', `放大查看${section.label}图表`); const image = document.createElement('img'); image.src = url; image.alt = `${section.label} 图表，点击可放大`; image.loading = 'lazy'; link.append(image); images?.append(link); }
        const audioWrap = $<HTMLElement>('[data-audio-wrap]'); const audio = $<HTMLAudioElement>('[data-audio]');
        if (audioWrap && audio) { audioWrap.hidden = !section.audioUrl; audio.src = section.audioUrl || ''; }
        if (data.subject !== 'writing') renderBlocks();
        const answers = $<HTMLElement>('[data-answer-scroll]'); answers?.replaceChildren();
        if (data.subject === 'writing') {
          const textarea = document.createElement('textarea'); textarea.className = 'essay'; textarea.setAttribute('aria-label', `Task ${state.active + 1} answer`); textarea.spellcheck = false; textarea.autocapitalize = 'off'; textarea.autocomplete = 'off'; textarea.value = state.answers[String(state.active + 1)] || ''; textarea.disabled = state.finished;
          textarea.addEventListener('input', () => { state.answers[String(state.active + 1)] = textarea.value; save(); const count = $<HTMLElement>('[data-word-count]'); if (count) count.textContent = `${words(textarea.value)} words`; }); answers?.append(textarea);
          const count = $<HTMLElement>('[data-word-count]'); if (count) count.textContent = `${words(textarea.value)} words`;
          const heading = $<HTMLElement>('[data-answer-heading]'); if (heading) heading.textContent = state.active === 0 ? 'at least 150 words' : 'at least 250 words';
        } else if (data.subject === 'reading') {
          const heading = $<HTMLElement>('[data-answer-heading]'); if (heading) heading.textContent = `${section.last - section.first + 1} answers`;
        }
        const review = $<HTMLInputElement>('[data-review]'); if (review) review.checked = !!state.review[state.active];
        const tabs = $<HTMLElement>('[data-section-tabs]'); tabs?.replaceChildren(); data.sections.forEach((item, index) => { const button = document.createElement('button'); button.type = 'button'; button.textContent = item.label; button.className = index === state.active ? 'active' : ''; if (state.review[index]) button.classList.add('reviewed'); button.addEventListener('click', () => { state.active = index; save(); render(); }); tabs?.append(button); });
        const prev = $<HTMLButtonElement>('[data-prev]'); if (prev) prev.disabled = state.active === 0;
        const next = $<HTMLButtonElement>('[data-next]'); if (next) next.disabled = state.active === data.sections.length - 1;
        readingTools?.render();
      };
      const enter = (fresh: boolean) => { if (fresh) { state = defaults(); state.started = true; state.deadline = Date.now() + duration * 1000; save(); } overlay?.remove(); render(); updateClock(); };
      const ready = document.querySelector<HTMLInputElement>('[data-ready]'); const start = document.querySelector<HTMLButtonElement>('[data-start-button]');
      ready?.addEventListener('change', () => { if (start) start.disabled = !ready.checked; }); start?.addEventListener('click', () => enter(true));
      const resume = document.querySelector<HTMLButtonElement>('[data-resume]'); if (resume) resume.disabled = !state.started; resume?.addEventListener('click', () => enter(false));
      $<HTMLInputElement>('[data-review]')?.addEventListener('change', (event) => { state.review[state.active] = (event.target as HTMLInputElement).checked; save(); render(); });
      $<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => { state.active = Math.max(0, state.active - 1); save(); render(); });
      $<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => { state.active = Math.min(data.sections.length - 1, state.active + 1); save(); render(); });
      $<HTMLButtonElement>('[data-submit]')?.addEventListener('click', () => {
        if (state.finished) { showDialog('本次练习已提交。可查看答案或重新开始。'); return; }
        if (!confirm('提交本次练习？提交后不能继续作答。')) return;
        state.finished = true; state.deadline = Date.now(); save(); render(); updateClock();
        if (data.subject === 'writing') {
          showDialog(`练习已提交。Task 1：${words(state.answers['1'] || '')} 词；Task 2：${words(state.answers['2'] || '')} 词。写作需人工评阅，不生成机器分数。`);
        } else {
          const normal = (value: string) => value.normalize('NFKC').trim().toLocaleLowerCase().replace(/\s+/g, ' ');
          const accepted = (given: string, expected: string) => expected.split('|').some((value) => normal(given) === normal(value));
          let score = 0;
          for (let number = 1; number <= 40; number++) {
            if (data.subject === 'listening' && [21, 22, 23, 24].includes(number)) continue;
            if (accepted(state.answers[String(number)] || '', data.answerKey[number - 1] || '')) score++;
          }
          if (data.subject === 'listening') {
            for (const pair of [[21, 22], [23, 24]]) {
              const remaining = pair.map((number) => data.answerKey[number - 1]);
              for (const number of pair) { const index = remaining.findIndex((expected) => accepted(state.answers[String(number)] || '', expected)); if (index >= 0) { score++; remaining.splice(index, 1); } }
            }
          }
          showDialog(`练习已提交：${score} / 40 题正确。仅显示原始对题数，不换算官方雅思分数。答案留在当前浏览器。`);
        }
      });
      document.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => { if (!confirm('清除本次练习的全部答案并重新开始？')) return; localStorage.removeItem(key); location.reload(); });
      $<HTMLButtonElement>('[data-help]')?.addEventListener('click', () => showDialog(`点击底部切换部分；答案自动保存在本机浏览器。${data.subject === 'reading' ? '拖动中间分隔条调整宽度（也可用方向键）；选中原文后点击高亮，选中高亮文字或点击色块可取消。窄屏上下排列。' : ''}请勿在共用设备上留下个人信息。`));
      $<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => { if (!confirm('清除本机保存的本次练习答案？')) return; localStorage.removeItem(key); location.reload(); });
      updateClock(); window.setInterval(updateClock, 1000);
    }
  </script>
</IeltsLayout>

