---
import IeltsLayout from '../../../layouts/IeltsLayout.astro';
import { getAuthContext } from '../../../lib/ielts/auth';
import test from '../../../lib/ielts/mock/test1-content.json';

export const prerender = false;

type Subject = 'listening' | 'reading' | 'writing';
const requested = Astro.url.searchParams.get('subject')?.toLowerCase();
const subject: Subject = requested === 'reading' || requested === 'writing' ? requested : 'listening';
const demo = import.meta.env.DEV && Astro.url.searchParams.get('demo') === '1';
if (!demo && !Astro.cookies.has('ielts_access') && !Astro.cookies.has('ielts_refresh')) return Astro.redirect(`/ielts?login=1&next=${encodeURIComponent(`/ielts/mock/test-1?subject=${subject}`)}`);
const auth = demo ? undefined : await getAuthContext(Astro.cookies);
if (!auth && !demo) return Astro.redirect(`/ielts?login=1&next=${encodeURIComponent(`/ielts/mock/test-1?subject=${subject}`)}`);

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const labels: Record<Subject, string> = { listening: 'Listening', reading: 'Reading', writing: 'Writing' };
const sections = test.sections[subject];
const answerKey = subject === 'writing' ? [] : test.answerKeys[subject];
const payload = JSON.stringify({ subject, sections, answerKey, accountId: auth?.user.id || 'demo' }).replace(/</g, '\\u003c');
---
<IeltsLayout title={`剑雅21 Test 1 · ${labels[subject]}`} description="雅思机考练习页面。">
  <main class="exam" data-exam>
    <header class="brandbar">
      <a class="brand" href="/ielts#mock" aria-label="返回学习中心"><strong>IELTS</strong><span>CAMBRIDGE 21<br />TEST 1 PRACTICE</span></a>
      <nav class="subjects" aria-label="选择科目">
        {(['listening', 'reading', 'writing'] as const).map((item) => <a class:list={[{ active: subject === item }]} href={`/ielts/mock/test-1?subject=${item}`}>{labels[item]}</a>)}
      </nav>
    </header>
    <div class="statusbar"><span>{labels[subject]} · Test 1</span><strong data-clock>{subject === 'listening' ? '35:00' : '60:00'}</strong><div class="toolbar"><button type="button" data-clear>清除本机答案</button><button type="button" data-help>Help</button></div></div>
    <div class="workspace">
      <section class="pane question-pane" aria-label="题目">
        <div class="pane-head"><h1 data-section-title></h1><span data-section-range></span></div>
        <div class="question-scroll" data-question-scroll tabindex="0">
          <p class="instructions" data-instructions></p>
          {subject === 'listening' && <div class="audio-wrap" data-audio-wrap hidden><audio controls preload="none" data-audio></audio></div>}
          <div data-passage></div>
          <div data-question-images></div>
          <details class="ocr-transcript" data-ocr-left hidden><summary>题目文字版（OCR，扫描图为准）</summary><pre data-ocr-left-text></pre></details>
          <details class="source-scan" data-source-scan hidden><summary>查看原书扫描页以核对 OCR 文字</summary><div data-reference-images></div></details>
        </div>
      </section>
      <section class="pane answer-pane" aria-label="答题区">
        <div class="pane-head"><h2>{subject === 'writing' ? 'Your answer' : 'Answer sheet'}</h2><span data-answer-heading></span></div>
        {subject === 'reading' && <div class="reading-questions" data-reading-questions><div data-reading-question-images></div><details class="ocr-transcript" data-ocr-right><summary>题目文字版（OCR，扫描图为准）</summary><pre data-ocr-right-text></pre></details></div>}
        <div class="answer-scroll" data-answer-scroll></div>
        {subject === 'writing' && <p class="word-count"><span data-word-count>0 words</span><span data-save-state>仅保存在本机浏览器</span></p>}
      </section>
    </div>
    <nav class="test-nav" aria-label="试卷导航"><label><input type="checkbox" data-review /> Mark for review</label><div class="section-tabs" data-section-tabs></div><div class="nav-actions"><button type="button" data-prev aria-label="上一部分">‹</button><button type="button" data-next aria-label="下一部分">›</button><button type="button" class="submit" data-submit>Submit</button></div></nav>
  </main>

  <div class="overlay" data-start><section class="modal" role="dialog" aria-modal="true" aria-labelledby="start-title"><div class="modal-head"><strong>IELTS</strong><h2 id="start-title">剑雅21 Test 1 · {labels[subject]}</h2></div><div class="modal-body"><p>按机考界面练习；答案和计时只保存在当前浏览器。关闭页面后重新打开，可继续本次练习。</p><p>{subject === 'listening' ? '35 分钟练习计时，含四段录音与检查时间。' : '60 分钟练习计时。'}提交后，听力和阅读会显示对题数；写作不自动估分。</p><label><input type="checkbox" data-ready /> 我已阅读并准备开始</label></div><div class="modal-actions"><button type="button" data-resume disabled>继续上次练习</button><button type="button" class="primary" data-start-button disabled>开始</button></div></section></div>
  <dialog class="result-dialog" data-dialog><div data-dialog-body></div><form method="dialog"><button type="button" data-reset>重新开始</button><button>关闭</button></form></dialog>
  <script is:inline type="application/json" id="exam-payload" set:html={payload} />

  <script>
    type Section = { label: string; first: number; last: number; title: string; instructions: string; paragraphs: string[]; questionImages: string[]; questionOcr: string[]; referenceImages: string[]; audioUrl: string };
    type Payload = { subject: 'listening' | 'reading' | 'writing'; sections: Section[]; answerKey: string[]; accountId: string };
    type Saved = { version: number; active: number; answers: Record<string, string>; review: boolean[]; started: boolean; finished: boolean; deadline: number };
    const root = document.querySelector<HTMLElement>('[data-exam]');
    const parsed = document.querySelector<HTMLElement>('#exam-payload');
    if (root && parsed) {
      const data = JSON.parse(parsed.textContent || '{}') as Payload;
      const key = `lenteyyy-mock-c21-t1-${data.subject}-${data.accountId}`;
      const duration = data.subject === 'listening' ? 35 * 60 : 60 * 60;
      const defaults = (): Saved => ({ version: 1, active: 0, answers: {}, review: data.sections.map(() => false), started: false, finished: false, deadline: 0 });
      const load = (): Saved => { try { const value = JSON.parse(localStorage.getItem(key) || 'null'); return value?.version === 1 && Array.isArray(value.review) ? value : defaults(); } catch { return defaults(); } };
      let state = load();
      const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector);
      const overlay = document.querySelector<HTMLElement>('[data-start]');
      const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');
      const dialogBody = document.querySelector<HTMLElement>('[data-dialog-body]');
      const save = () => { try { localStorage.setItem(key, JSON.stringify(state)); } catch { const status = $<HTMLElement>('[data-save-state]'); if (status) status.textContent = '本机存储不可用，离开页面会丢失答案'; } };
      const words = (value: string) => (value.match(/[\p{L}\p{N}]+(?:[’'-][\p{L}\p{N}]+)*/gu) || []).length;
      const formatTime = (seconds: number) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
      const showDialog = (message: string) => { if (dialogBody) dialogBody.textContent = message; dialog?.showModal(); };
      const updateClock = () => {
        const left = state.started ? Math.max(0, Math.ceil((state.deadline - Date.now()) / 1000)) : duration;
        const clock = $<HTMLElement>('[data-clock]'); if (clock) clock.textContent = formatTime(left);
        if (left === 0 && state.started && !state.finished) { state.finished = true; save(); render(); showDialog('时间已到。答案仍保存在当前浏览器。'); }
      };
      const render = () => {
        const section = data.sections[state.active]; if (!section) return;
        const title = $<HTMLElement>('[data-section-title]'); if (title) title.textContent = section.title;
        const range = $<HTMLElement>('[data-section-range]'); if (range) range.textContent = data.subject === 'writing' ? `Task ${state.active + 1}` : `Questions ${section.first}–${section.last}`;
        const instructions = $<HTMLElement>('[data-instructions]'); if (instructions) instructions.textContent = section.instructions;
        const passage = $<HTMLElement>('[data-passage]'); passage?.replaceChildren();
        for (const text of section.paragraphs) { const paragraph = document.createElement('p'); paragraph.textContent = text; passage?.append(paragraph); }
        const images = $<HTMLElement>(data.subject === 'reading' ? '[data-reading-question-images]' : '[data-question-images]'); images?.replaceChildren();
        for (const url of section.questionImages) { const link = document.createElement('a'); link.href = url; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.setAttribute('aria-label', `放大查看${section.label}题图`); const image = document.createElement('img'); image.src = url; image.alt = `${section.label} 题目或图表，点击可放大`; image.loading = 'lazy'; link.append(image); images?.append(link); }
        const transcript = $<HTMLDetailsElement>(data.subject === 'reading' ? '[data-ocr-right]' : '[data-ocr-left]');
        const transcriptText = $<HTMLElement>(data.subject === 'reading' ? '[data-ocr-right-text]' : '[data-ocr-left-text]');
        if (transcript) transcript.hidden = section.questionOcr.length === 0;
        if (transcriptText) transcriptText.textContent = section.questionOcr.join('\n\n');
        const sourceScan = $<HTMLDetailsElement>('[data-source-scan]'); const referenceImages = $<HTMLElement>('[data-reference-images]'); referenceImages?.replaceChildren();
        if (sourceScan) sourceScan.hidden = section.referenceImages.length === 0;
        for (const url of section.referenceImages) { const image = document.createElement('img'); image.src = url; image.alt = `${section.label} 原书扫描页`; image.loading = 'lazy'; referenceImages?.append(image); }
        const audioWrap = $<HTMLElement>('[data-audio-wrap]'); const audio = $<HTMLAudioElement>('[data-audio]');
        if (audioWrap && audio) { audioWrap.hidden = !section.audioUrl; audio.src = section.audioUrl || ''; }
        const answers = $<HTMLElement>('[data-answer-scroll]'); answers?.replaceChildren();
        if (data.subject === 'writing') {
          const textarea = document.createElement('textarea'); textarea.className = 'essay'; textarea.setAttribute('aria-label', `Task ${state.active + 1} answer`); textarea.spellcheck = false; textarea.autocapitalize = 'off'; textarea.autocomplete = 'off'; textarea.value = state.answers[String(state.active + 1)] || ''; textarea.disabled = state.finished;
          textarea.addEventListener('input', () => { state.answers[String(state.active + 1)] = textarea.value; save(); const count = $<HTMLElement>('[data-word-count]'); if (count) count.textContent = `${words(textarea.value)} words`; }); answers?.append(textarea);
          const count = $<HTMLElement>('[data-word-count]'); if (count) count.textContent = `${words(textarea.value)} words`;
          const heading = $<HTMLElement>('[data-answer-heading]'); if (heading) heading.textContent = state.active === 0 ? 'at least 150 words' : 'at least 250 words';
        } else {
          for (let number = section.first; number <= section.last; number++) { const label = document.createElement('label'); label.className = 'answer-row'; const numberText = document.createElement('strong'); numberText.textContent = String(number); const input = document.createElement('input'); input.type = 'text'; input.autocomplete = 'off'; input.spellcheck = false; input.setAttribute('aria-label', `Question ${number}`); input.value = state.answers[String(number)] || ''; input.disabled = state.finished; input.addEventListener('input', () => { state.answers[String(number)] = input.value; save(); }); label.append(numberText, input); if (state.finished) { const reference = document.createElement('small'); reference.textContent = `参考：${data.answerKey[number - 1]?.replaceAll('|', ' / ') || '—'}`; label.append(reference); } answers?.append(label); }
          const heading = $<HTMLElement>('[data-answer-heading]'); if (heading) heading.textContent = `${section.last - section.first + 1} answers`;
        }
        const review = $<HTMLInputElement>('[data-review]'); if (review) review.checked = !!state.review[state.active];
        const tabs = $<HTMLElement>('[data-section-tabs]'); tabs?.replaceChildren(); data.sections.forEach((item, index) => { const button = document.createElement('button'); button.type = 'button'; button.textContent = item.label; button.className = index === state.active ? 'active' : ''; if (state.review[index]) button.classList.add('reviewed'); button.addEventListener('click', () => { state.active = index; save(); render(); }); tabs?.append(button); });
        const prev = $<HTMLButtonElement>('[data-prev]'); if (prev) prev.disabled = state.active === 0;
        const next = $<HTMLButtonElement>('[data-next]'); if (next) next.disabled = state.active === data.sections.length - 1;
      };
      const enter = (fresh: boolean) => { if (fresh) { state = defaults(); state.started = true; state.deadline = Date.now() + duration * 1000; save(); } overlay?.remove(); render(); updateClock(); };
      const ready = document.querySelector<HTMLInputElement>('[data-ready]'); const start = document.querySelector<HTMLButtonElement>('[data-start-button]');
      ready?.addEventListener('change', () => { if (start) start.disabled = !ready.checked; }); start?.addEventListener('click', () => enter(true));
      const resume = document.querySelector<HTMLButtonElement>('[data-resume]'); if (resume) resume.disabled = !state.started; resume?.addEventListener('click', () => enter(false));
      $<HTMLInputElement>('[data-review]')?.addEventListener('change', (event) => { state.review[state.active] = (event.target as HTMLInputElement).checked; save(); render(); });
      $<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => { state.active = Math.max(0, state.active - 1); save(); render(); });
      $<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => { state.active = Math.min(data.sections.length - 1, state.active + 1); save(); render(); });
      $<HTMLButtonElement>('[data-submit]')?.addEventListener('click', () => {
        if (state.finished) { showDialog('本次练习已提交。可查看答案或重新开始。'); return; }
        if (!confirm('提交本次练习？提交后不能继续作答。')) return;
        state.finished = true; state.deadline = Date.now(); save(); render(); updateClock();
        if (data.subject === 'writing') {
          showDialog(`练习已提交。Task 1：${words(state.answers['1'] || '')} 词；Task 2：${words(state.answers['2'] || '')} 词。写作需人工评阅，不生成机器分数。`);
        } else {
          const normal = (value: string) => value.normalize('NFKC').trim().toLocaleLowerCase().replace(/\s+/g, ' ');
          const accepted = (given: string, expected: string) => expected.split('|').some((value) => normal(given) === normal(value));
          let score = 0;
          for (let number = 1; number <= 40; number++) {
            if (data.subject === 'listening' && [21, 22, 23, 24].includes(number)) continue;
            if (accepted(state.answers[String(number)] || '', data.answerKey[number - 1] || '')) score++;
          }
          if (data.subject === 'listening') {
            for (const pair of [[21, 22], [23, 24]]) {
              const remaining = pair.map((number) => data.answerKey[number - 1]);
              for (const number of pair) { const index = remaining.findIndex((expected) => accepted(state.answers[String(number)] || '', expected)); if (index >= 0) { score++; remaining.splice(index, 1); } }
            }
          }
          showDialog(`练习已提交：${score} / 40 题正确。仅显示原始对题数，不换算官方雅思分数。答案留在当前浏览器。`);
        }
      });
      document.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => { if (!confirm('清除本次练习的全部答案并重新开始？')) return; localStorage.removeItem(key); location.reload(); });
      $<HTMLButtonElement>('[data-help]')?.addEventListener('click', () => showDialog('点击底部切换部分；答案自动保存在本机浏览器。请勿在共用设备上留下个人信息。'));
      $<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => { if (!confirm('清除本机保存的本次练习答案？')) return; localStorage.removeItem(key); location.reload(); });
      updateClock(); window.setInterval(updateClock, 1000);
    }
  </script>
</IeltsLayout>

<style>
  :global(body.ielts-site) { overflow: hidden; background: #dce6f2; }
  .exam { height: 100dvh; min-height: 520px; display: grid; grid-template-rows: 72px 42px minmax(0, 1fr) 66px; color: #20252a; font: 16px Arial, sans-serif; }
  button, input, textarea { font: inherit; }
  .brandbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 22px; background: #fff; border-top: 3px solid #d71920; border-bottom: 1px solid #d9dde1; }
  .brand { display: flex; align-items: center; gap: 17px; min-width: 0; }
  .brand strong { color: #d71920; font: 700 38px Georgia, serif; letter-spacing: -1.8px; }
  .brand span { padding-left: 18px; border-left: 1px solid #d8dce0; color: #525b63; font-size: 12px; line-height: 1.4; letter-spacing: .08em; }
  .subjects { display: flex; gap: 8px; }
  .subjects a { padding: 9px 12px; border: 1px solid #c8cdd2; border-radius: 4px; color: #27343b; font-size: 13px; }
  .subjects a.active { color: #fff; background: #263238; border-color: #263238; }
  .statusbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 16px; background: linear-gradient(#3c474d, #172127); color: #fff; font-size: 13px; font-weight: 700; }
  .statusbar strong { color: #fff4c5; font-size: 22px; font-variant-numeric: tabular-nums; }
  .toolbar { justify-self: end; display: flex; gap: 6px; }
  .statusbar button { padding: 4px 12px; border: 1px solid #68737a; border-radius: 4px; background: #edf0f2; color: #111; cursor: pointer; }
  .workspace { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(320px, 1fr); min-height: 0; gap: 10px; padding: 10px; }
  .pane { display: flex; flex-direction: column; min-height: 0; min-width: 0; overflow: hidden; border: 1px solid #aeb7bf; border-radius: 6px; background: #fff; box-shadow: 0 1px 4px #1b2b3a26; }
  .pane-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 48px; padding: 10px 16px; border-bottom: 1px solid #d6dadd; background: linear-gradient(#fff, #edf1f4); }
  .pane-head h1, .pane-head h2 { margin: 0; font-size: 17px; }
  .pane-head span { color: #4f5d68; font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .question-scroll, .answer-scroll { flex: 1; min-height: 0; overflow: auto; padding: 20px 22px; line-height: 1.58; }
  .instructions { padding: 13px 15px; border-left: 4px solid #d71920; background: #f7f8fa; }
  [data-passage] :global(p) { margin: 0 0 17px; }
  [data-question-images] :global(img) { display: block; width: 100%; height: auto; margin: 15px 0; border: 1px solid #c8cdd2; }
  [data-question-images] :global(a), .reading-questions :global(a) { display: block; cursor: zoom-in; }
  .reading-questions { flex: 0 0 55%; min-height: 0; overflow: auto; padding: 10px 20px; border-bottom: 1px solid #d6dadd; }
  .reading-questions :global(img) { display: block; width: 100%; height: auto; margin: 10px 0; border: 1px solid #c8cdd2; }
  .source-scan { margin: 20px 0; padding: 10px 12px; border: 1px solid #c8cdd2; border-radius: 5px; background: #f7f9fb; }
  .source-scan summary { cursor: pointer; font-size: 13px; font-weight: 700; }
  .source-scan :global(img) { display: block; width: 100%; height: auto; margin: 12px 0; border: 1px solid #c8cdd2; }
  .ocr-transcript { margin: 15px 0; padding: 10px 12px; border: 1px solid #c8cdd2; border-radius: 5px; background: #f7f9fb; }
  .ocr-transcript summary { cursor: pointer; font-size: 13px; font-weight: 700; }
  .ocr-transcript pre { overflow-wrap: anywhere; white-space: pre-wrap; color: #20252a; font: 13px/1.55 Arial, sans-serif; }
  .audio-wrap { margin: 16px 0; } audio { width: 100%; }
  :global(.answer-row) { display: grid; grid-template-columns: 32px 1fr; align-items: center; gap: 8px; margin: 0 0 11px; }
  :global(.answer-row input) { width: 100%; min-height: 38px; padding: 7px 10px; border: 1px solid #8d969d; border-radius: 3px; background: #fff; color: #111; }
  :global(.answer-row small) { grid-column: 2; color: #4f5d68; font-size: 12px; }
  :global(.essay) { display: block; width: 100%; height: 100%; min-height: 200px; padding: 15px; resize: none; border: 1px solid #8d969d; border-radius: 2px; outline: none; background: #fff; color: #111; }
  .word-count { display: flex; justify-content: space-between; margin: 0; padding: 5px 16px 9px; color: #4f5961; font-size: 12px; }
  .test-nav { display: grid; grid-template-columns: 150px 1fr auto; align-items: center; gap: 10px; padding: 8px 12px; background: linear-gradient(#35444d, #121d23); color: #fff; font-size: 13px; }
  .test-nav label { display: flex; align-items: center; gap: 8px; }
  .test-nav input { width: 18px; height: 18px; }
  .section-tabs { display: flex; justify-content: center; gap: 7px; min-width: 0; overflow: auto; }
  .section-tabs :global(button), .nav-actions button { min-height: 42px; padding: 8px 12px; border: 1px solid #070b0d; border-radius: 4px; background: linear-gradient(#56636b, #27343b); color: #fff; cursor: pointer; }
  .section-tabs :global(button.active) { background: #fff; color: #111; }
  .section-tabs :global(button.reviewed) { box-shadow: inset 0 4px #f3c318; }
  .nav-actions { display: flex; gap: 7px; } .nav-actions .submit { background: linear-gradient(#b72c31, #7e1317); }
  button:disabled { opacity: .45; cursor: not-allowed; }
  .overlay { position: fixed; inset: 0; z-index: 30; display: grid; place-items: center; padding: 24px; background: #10181fc7; color: #20252a; }
  .modal { width: min(600px, 100%); max-height: 90dvh; overflow: auto; border-radius: 7px; background: #fff; box-shadow: 0 18px 60px #0008; }
  .modal-head { padding: 18px 20px; border-bottom: 1px solid #d9dde1; background: #f4f6f7; }
  .modal-head strong { color: #d71920; font: 700 34px Georgia, serif; } .modal-head h2 { margin: 6px 0 0; font-size: 19px; }
  .modal-body { padding: 20px; line-height: 1.55; } .modal-body label { display: flex; align-items: center; gap: 8px; }
  .modal-actions { display: flex; justify-content: end; gap: 10px; padding: 14px 20px; border-top: 1px solid #d9dde1; background: #f7f8f9; }
  .modal-actions button, .result-dialog button { min-height: 40px; padding: 8px 17px; border: 1px solid #9ca5ac; border-radius: 4px; background: #fff; color: #222; cursor: pointer; }
  .modal-actions .primary { border-color: #075683; background: #0d72ac; color: #fff; }
  .result-dialog { width: min(460px, calc(100vw - 32px)); padding: 22px; border: 0; border-radius: 6px; background: #fff; color: #20252a; box-shadow: 0 18px 60px #0008; }
