---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';

export async function getStaticPaths() {
	return (await getTags()).map(({ tag }) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.tags.includes(tag));
---
<BaseLayout title={`#${tag} · Lenteyyy`} description={`Lenteyyy 中关于 ${tag} 的文章。`}>
	<section class="tag-page shell">
		<h1>#{tag}</h1>
		<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
	</section>
</BaseLayout>

<style>
	.tag-page { padding-top: 86px; }
	h1 { margin: 0 0 54px; font-size: clamp(48px, 8vw, 98px); line-height: 1; font-weight: 600; letter-spacing: 0; }
	.post-list { display: grid; gap: 42px; }
</style>
