---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { getPosts } from '../../lib/posts';
import { localizedPath, translateText } from '../../lib/locale';

const locale = 'zh-TW' as const;
const posts = await getPosts();
const featured = posts.filter((post) => post.featured).concat(posts).filter((post, index, array) => array.findIndex((item) => item.id === post.id) === index).slice(0, 3);
const categories = [...new Set(posts.map((post) => post.category))];
const path = (value: string) => localizedPath(value, locale);
---
<BaseLayout locale={locale} title="Lenteyyy · 個人部落格" description="飯店、旅行、音樂和一些個人雜談。">
	<section class="intro shell">
		<div class="intro-copy">
			<h1>歡迎！</h1>
			<div class="intro-description">
				<p class="lead">你好，我是 Lenteyyy，也可以叫我冷踢踢。</p>
				<p class="lead">這裡記錄冷踢踢莫名其妙的生活，住過的飯店以及一些瑣碎的事情。</p>
				<p class="lead">關於雅思學習的事情，頁面最下方可以跳轉至冷踢踢的雅思學習網站。</p>
			</div>
			<div class="intro-links"><a href={path('/posts')}>瀏覽文章 ↗</a><a href={path('/about')}>關於我</a></div>
		</div>
		<div class="intro-note">
			<span>Contact</span>
			<!--email_off-->
			<a href="mailto:lenteyteytey@gmail.com">lenteyteytey@gmail.com</a>
			<!--/email_off-->
			<div class="social-media">
				<span class="social-title">Social Media</span>
				<SocialLinks locale={locale} />
			</div>
		</div>
	</section>

	<section class="archive shell">
		<div class="section-head"><p class="eyebrow">我寫的東西</p><a href={path('/posts')}>查看全部 {posts.length} 篇 ↗</a></div>
		{featured.length > 0 ? <div class="post-list">{featured.map((post) => <PostCard post={post} locale={locale} />)}</div> : <p class="empty">這裡暫時還沒有文章。</p>}
	</section>

	{categories.length > 0 && <section class="categories shell">
		<div class="section-head"><p class="eyebrow">文章分類</p></div>
		<div class="category-row">{categories.map((category) => <a href={path(`/posts/category/${encodeURIComponent(category)}`)}>{translateText(category, locale)}<span>↗</span></a>)}</div>
	</section>}
</BaseLayout>

<style>
	.intro { min-height: 560px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 280px); align-items: center; gap: clamp(40px, 8vw, 120px); padding: 58px 0 70px; }
	.eyebrow { margin: 0; color: var(--muted); font: 0.75rem/1.5 var(--mono); letter-spacing: .12em; }
	h1 { margin: 18px 0 30px; font-size: clamp(3rem, 8.5vw, 6.75rem); line-height: .95; letter-spacing: -.03em; font-weight: 600; }
	.lead { max-width: 480px; margin: 0; color: var(--muted); font-size: 1.0625rem; line-height: 1.9; }
	.lead + .lead { margin-top: 1.15em; }
	.intro-links { display: flex; gap: 24px; margin-top: 34px; font: 0.75rem var(--mono); letter-spacing: .02em; }
	.intro-links a:first-child { color: var(--accent); }
	.intro-links a:hover { color: var(--accent); }
	.intro-note { align-self: end; width: min(240px, 100%); padding-bottom: 8px; color: var(--muted); }
	.intro-note > span { display: block; margin-bottom: 14px; color: var(--muted); font: 0.75rem/1.5 var(--mono); letter-spacing: .14em; text-transform: uppercase; }
	.intro-note > a { display: block; color: var(--muted); font-size: 0.8125rem; line-height: 1.8; overflow-wrap: anywhere; }
	.intro-note > a:hover { color: var(--accent); }
	.social-media { margin-top: 34px; }
	.social-title { display: block; margin-bottom: 14px; color: var(--muted); font: 0.75rem/1.5 var(--mono); letter-spacing: .14em; text-transform: uppercase; }
	.archive { padding-top: 72px; }
	.section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-bottom: 22px; }
	.section-head a { color: var(--muted); font: 0.75rem var(--mono); }
	.section-head a:hover { color: var(--accent); }
	.post-list { display: grid; gap: 42px; }
	.empty { color: var(--muted); font-size: 0.9375rem; line-height: 1.9; }
	.categories { padding-top: 96px; }
	.category-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
	.category-row a { display: flex; align-items: center; justify-content: space-between; min-height: 88px; padding: 0 2px; border-top: 1px solid var(--line); color: var(--muted); font-size: 1.0625rem; transition: color 180ms ease, border-color 180ms ease; }
	.category-row a:hover { color: var(--accent); }
	.category-row span { font: 1rem var(--mono); }
	@media (max-width: 900px) { .intro { grid-template-columns: 1fr; min-height: 0; } .intro-note { align-self: start; } }
	@media (max-width: 700px) { .intro { gap: 34px; padding-top: 52px; padding-bottom: 58px; } .lead { font-size: 1rem; } .category-row { grid-template-columns: 1fr; gap: 0; } }
</style>
