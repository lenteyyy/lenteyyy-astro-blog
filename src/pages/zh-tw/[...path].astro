---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
Astro.response.status = 404;
---
<BaseLayout locale="zh-TW" title="Oops，頁面不存在！ · Lenteyyy" description="或許你造訪了冷踢踢也找不到的頁面...？" noindex={true}>
	<section class="not-found shell">
		<p class="eyebrow">404</p>
		<h1>Oops，頁面不存在<span>！</span></h1>
		<p>或許你造訪了冷踢踢也找不到的頁面...？</p>
		<a href="/zh-tw/posts">回到文章列表 ↗</a>
	</section>
</BaseLayout>

<style>
	.not-found { padding-top: 120px; min-height: 520px; }
	.eyebrow { margin: 0; color: var(--muted); font: 0.75rem/1.5 var(--mono); letter-spacing: .08em; }
	h1 { margin: 18px 0 20px; font-size: clamp(2.875rem, 9.5625vw, 6.25rem); line-height: 1.05; font-weight: 600; letter-spacing: 0; }
	h1 span, a { color: var(--accent); }
	p { max-width: 560px; color: var(--muted); font-size: 1.0625rem; line-height: 1.9; }
	a { display: inline-block; margin-top: 22px; font: 0.75rem var(--mono); }
</style>
