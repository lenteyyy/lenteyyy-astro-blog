{
  "name": "lenteyyy-astro-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-content.mjs && astro build && node scripts/optimize-static-images.mjs && node scripts/harden-build-routes.mjs && node scripts/verify-blog-csp.mjs && node scripts/verify-project-isolation.mjs",
    "check": "astro check",
    "lint": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "astro preview",
    "content:sync": "node scripts/sync-media.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "security:target": "node scripts/verify-deployment-target.mjs --online",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/vercel": "11.0.5",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-sans-tc": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/og": "1.0.1",
    "@vercel/speed-insights": "2.0.0",
    "astro": "7.2.8",
    "marked": "18.0.13",
    "opencc-js": "1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
